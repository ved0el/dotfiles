/*
  Mocha Islands — yasb "adaptive" bar tuned to this desktop.
  The palette is Catppuccin Mocha (as the terminal); the accent #89b4fa is the exact colour komorebi
  paints on the focused window's border, so the bar reads as part of the desktop. Islands are a deep crust fill with a faint
  lavender stroke; icons are Segoe Fluent (native Windows set), text is Segoe UI Variable.
  Nerd Font only where Segoe has no glyph set: komorebi layouts, weather, whkd/wifi Material.
  Alpha is always rgba(), never 8-digit hex (Qt reads #RRGGBBAA alpha-first).
*/
:root {
    /* Catppuccin Mocha */
    --rosewater: #f5e0dc;
    --pink: #f5c2e7;
    --mauve: #cba6f7;
    --red: #f38ba8;
    --maroon: #eba0ac;
    --peach: #fab387;
    --yellow: #f9e2af;
    --green: #a6e3a1;
    --teal: #94e2d5;
    --sky: #89dceb;
    --sapphire: #74c7ec;
    --blue: var(--accent); /* the Windows accent stands in for Mocha blue */
    --lavender: #b4befe;
    --text: #cdd6f4;
    --subtext1: #bac2de;
    --subtext0: #a6adc8;
    --overlay1: #7f849c;
    --overlay0: #6c7086;
    --surface2: #585b70;
    --surface1: #45475a;
    --surface0: #313244;
    --base: #1e1e2e;
    --mantle: #181825;
    --crust: #11111b;

    /* Surfaces */
    --yasb-bar-bg: rgba(17, 17, 27, 0.94);
    --yasb-island-stroke: rgba(180, 190, 254, 0.13);
    --yasb-surface-alt: #45475a;
    --yasb-popup-bg: rgba(17, 17, 27, 0.88);
    --yasb-dialog-bg: #11111b;
    --yasb-dialog-surface: #181825;
    --yasb-white-alpha-03: rgba(205, 214, 244, 0.03);
    --yasb-white-alpha-05: rgba(205, 214, 244, 0.05);
    --yasb-white-alpha-06: rgba(205, 214, 244, 0.06);
    --yasb-white-alpha-07: rgba(205, 214, 244, 0.07);
    --yasb-white-alpha-10: rgba(205, 214, 244, 0.09);
    --yasb-white-alpha-15: rgba(205, 214, 244, 0.13);
    --yasb-white-alpha-20: rgba(205, 214, 244, 0.11);
    --yasb-white-alpha-30: rgba(205, 214, 244, 0.3);
    --yasb-white-alpha-40: rgba(205, 214, 244, 0.4);
    --yasb-white-alpha-70: rgba(205, 214, 244, 0.7);
    --yasb-white-alpha-80: rgba(205, 214, 244, 0.8);
    --yasb-white-alpha-85: rgba(205, 214, 244, 0.85);
    /* Text */
    --yasb-fg: #cdd6f4;
    --yasb-fg-muted: #7f849c;
    --yasb-icon-fg: #bac2de;
    --yasb-tooltip-bg: #181825;
    --yasb-tooltip-border: rgba(180, 190, 254, 0.13);
    /* Accent: one fixed colour (Mocha blue), the same hex komorebi paints on the focused window's
       DWM border (border_colours in komorebi.json). Change both together. */
    --accent: #89b4fa;
    --accent-rgb: 137, 180, 250;
    --yasb-accent: #89b4fa;
    --yasb-accent-hover: #a3c4fb;
    --yasb-accent-fg: #11111b;
    /* Fonts */
    --icons-font: "Segoe Fluent Icons";
    /* Propo: each glyph advances by its own ink width, so nothing clips or needs min-width.
       Qt matches the full name only — the short "JetBrainsMono NFP" resolves to Tahoma. */
    --icons-font-fallback: "JetBrainsMono Nerd Font Propo";
    --system-font: "Segoe UI Variable", "Noto Sans JP", "Segoe UI";
}
/* Global Defaults */
* {
    font-size: 13px;
    font-weight: 400;
    font-family: var(--system-font);
    color: var(--yasb-fg);
}
/* Bar: the fill paints the islands; yasb cuts the gaps between them out */
.yasb-bar {
    background-color: var(--yasb-bar-bg);
}
.yasb-bar.adaptive {
    border: none;
    -qproperty-islands: true;
    -qproperty-railheight: 3;
    /* 8px = the window corner (Windhawk) = the inner edge of komorebi's rounded border, which
       komorebi hardcodes as 8 + width/2 (border.rs) */
    -qproperty-islandradius: 8;
    -qproperty-edgeradius: 8;
    -qproperty-grouppadding: 8;
    -qproperty-borderwidth: 1;
    -qproperty-bordercolor: rgba(180, 190, 254, 0.13);
}
/* Tooltip */
.tooltip {
    background-color: var(--yasb-tooltip-bg);
    border-radius: 4px;
    color: var(--yasb-fg);
    padding: 5px 10px;
    font-size: 12px;
    font-family: var(--system-font);
    font-weight: 600;
    margin-top: 4px;
    border: 1px solid var(--yasb-tooltip-border);
}
/* Context Menu */
.context-menu,
.context-menu .menu-checkbox {
    background-color: var(--yasb-bar-bg);
    padding: 4px 0px;
    font-family: var(--system-font);
    font-weight: 600;
    font-size: 12px;
    color: var(--yasb-fg);
}
.context-menu {
    border-radius: 8px;
    border: 1px solid var(--yasb-white-alpha-07);
}
.context-menu::right-arrow {
    width: 8px;
    height: 8px;
    padding-right: 24px;
}
.context-menu::item,
.context-menu .menu-checkbox {
    background-color: transparent;
    padding: 6px 12px;
    margin: 2px 6px;
    border-radius: 6px;
    min-width: 100px;
}
.context-menu::item:selected,
.context-menu .menu-checkbox:hover {
    background-color: var(--yasb-white-alpha-10);
    color: #FFFFFF;
}
.context-menu::separator {
    height: 1px;
    background-color: rgba(205, 214, 244, 0.09);
    margin: 4px 8px;
}
.context-menu::item:disabled {
    color: #666666;
    background-color: transparent;
}
.context-menu .menu-checkbox .checkbox {
    border: none;
    padding: 8px 16px;
    font-size: 12px;
    margin: 0;
    color: var(--yasb-fg);
    font-family: var(--system-font);
    font-weight: 600;
}
.context-menu .submenu::item:disabled {
    margin: 0;
    padding-left: 16px;
}
.context-menu .menu-checkbox .checkbox:unchecked {
    color: var(--yasb-fg);
}
.context-menu .menu-checkbox .checkbox::indicator {
    width: 12px;
    height: 12px;
    margin-left: 0px;
    margin-right: 8px;
}
.context-menu .menu-checkbox .checkbox::indicator:unchecked {
    background: #45475a;
    border-radius: 2px;
}
.context-menu .menu-checkbox .checkbox::indicator:checked {
    background: var(--accent);
    border-radius: 2px;
}
.context-menu .menu-checkbox .checkbox:focus {
    outline: none;
}
/* Base Widget Styles */
.widget {
    padding: 0px 6px;
    margin: 4px 0;
    border-radius: 14px;
    cursor: pointer;
}
.widget .icon {
    font-size: 17px;
    font-weight: 400;
    color: var(--yasb-icon-fg);
    font-family: var(--icons-font);
}
.widget .label {
    color: var(--yasb-fg);
    font-weight: 600;
    padding-bottom: 2px;
}
/* Clock */
.clock-widget:hover {
    background-color: var(--yasb-white-alpha-20);
}
.clock-widget .icon.alarm {
    color: var(--accent);
    padding-left: 4px;
}
.clock-widget .label {
    color: #ffffff;
    margin: 0 5px;
}
/* Volume */
.volume-widget:hover {
    background-color: var(--yasb-white-alpha-20);
}
/* System Tray */
.systray:hover {
    background-color: var(--yasb-white-alpha-20);
}
.systray .button {
    border-radius: 4px;
    padding: 2px;
    background: transparent;
    border: none;
    outline: none;
}
.systray .button.drag-over {
    background: var(--yasb-white-alpha-40);
}
.systray .pinned-container.drop-target {
    background: var(--yasb-white-alpha-10);
}
.systray .unpinned-visibility-btn {
    border-radius: 4px;
    height: 20px;
    width: 16px;
    border: none;
    outline: none;
    padding-right: 0;
    font-family: var(--icons-font);
}
.systray .unpinned-visibility-btn:checked {
    background: transparent;
}
.systray .pinned-container.pinned-container.drop-target {
    background-color: var(--yasb-white-alpha-10);
}
/* Open Meteo */
.open-meteo-widget:hover {
    background-color: var(--yasb-white-alpha-20);
}
.open-meteo-widget .icon {
    color: #f9e2af;
}
.notification-widget:hover {
    background-color: var(--yasb-white-alpha-20);
}
/* Control center */
.control-center-widget:hover {
    background-color: var(--yasb-white-alpha-20);
}
/* --- SHARED SEGOE FLUENT ICONS --- */
/* --- SHARED HOVER & TRANSITION TRANSITIONS --- */
/* --- SHARED CLICKED / PRESSED STATES (Opacity 0.5) --- */
/* --- SHARED DISABLED STATES (Opacity 0.5) --- */
/* --- SYSTEM CONTROLS --- */
/* --- QUICK ACTIONS --- */
/* --- SLIDERS --- */
/* --- POWER PLAN & POWER MODE --- */
/* --- MEDIA CONTROLS --- */
.context-menu::indicator:checked {
    width: 4px;
    height: 12px;
    background-color: var(--accent);
    border-radius: 2px;
    margin-left: 8px;
}
/* Taskbar widget */
.taskbar-widget .app-container {
    margin: 0 2px;
    border-radius: 12px;
    padding: 0 8px;
    border: 1px solid transparent;
    background-color: transparent;
    transition: padding 0.3s, background-color 0.3s
}
.taskbar-widget .app-container.foreground {
    background-color: rgba(255, 255, 255, 0.15);
    padding: 0 16px;
}
.taskbar-widget .app-container.running {
    background-color: transparent;
}
.taskbar-widget .app-container:hover {
    background-color: rgba(255, 255, 255, 0.15);
}
.taskbar-widget .app-container .app-title {
    padding-left: 4px;
    font-size: 12px;
}
.taskbar-widget .app-container.grouped {
    background-color: rgba(255, 255, 255, 0.15);
}
/* Flashing always needs to go last so it doesn't get overwritten. */
.taskbar-widget .app-container.flashing {
    background-color: rgba(172, 21, 21, 0.6);
}
.taskbar-widget .app-container.flashing .app-count {
    background-color: rgba(241, 127, 127, 0.3);
}
/* ================================================================== */
/* Mocha Islands — overrides and widgets the island base doesn't cover */
/* ================================================================== */
/* Hover pills: 4px, the small radius tier (Windhawk smallRadius, popups "small") */
.widget {
    padding: 0 8px;
    margin: 5px 1px;
    border-radius: 4px;
    background-color: transparent;
}
.widget .label {
    font-weight: 500;
    padding-bottom: 1px;
}
/* Segoe icons ink their full em box while 13px text inks ~9.5px cap height; at 16px and the
   text colour the outline glyphs carry the same visual weight as a 500-weight label. */
.widget .icon {
    font-size: 16px;
    color: var(--text);
}
/* Gap via padding: yasb strips the space after a span in some widgets (cpu/memory/wifi) */
.widget .tag {
    font-size: 11px;
    font-weight: 600;
    color: var(--overlay1);
    padding-right: 5px;
}
.tooltip {
    background-color: var(--mantle);
    color: var(--text);
    border: 1px solid var(--yasb-island-stroke);
    border-radius: 4px;
    font-weight: 500;
}
.context-menu {
    background-color: var(--crust);
    border: 1px solid var(--yasb-island-stroke);
}
.context-menu::indicator:checked {
    background-color: var(--blue);
}
/* --- Home --- */
.home-widget .icon {
    font-size: 16px;
    color: var(--lavender);
}
.home-widget .icon:hover {
    color: var(--text);
}
.home-widget:hover {
    background-color: var(--yasb-white-alpha-10);
}
/* --- Komorebi active layout (Material glyphs: Segoe has no layout set) --- */
.komorebi-active-layout {
    padding: 0 6px;
}
.komorebi-active-layout:hover {
    background-color: var(--yasb-white-alpha-10);
}
.komorebi-active-layout .label {
    font-family: var(--icons-font-fallback);
    font-size: 16px;
    font-weight: 400;
    color: var(--subtext1);
    padding: 0;
}
/* --- Komorebi workspaces: 8px dot per inactive workspace, the active one a 16px (2x) accent pill --- */
.komorebi-workspaces {
    padding: 0 4px;
}
.komorebi-workspaces .offline-status {
    color: var(--overlay1);
    padding: 0 4px;
}
.komorebi-workspaces .ws-btn {
    color: transparent;
    font-size: 1px;
    border: none;
    padding: 0;
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
    margin: 0 3px;
    border-radius: 4px;
    background-color: var(--surface1);
}
.komorebi-workspaces .ws-btn:hover {
    background-color: var(--overlay1);
}
.komorebi-workspaces .ws-btn.populated {
    background-color: var(--overlay0);
}
.komorebi-workspaces .ws-btn.active {
    min-width: 16px; /* 2x the 8px dot, same rule as the taskbar marks */
    max-width: 16px;
    background-color: var(--accent);
}
/* --- Active window: the focused app as its own chip --- */
.active-window-widget {
    padding: 0 10px 0 8px;
}
.active-window-widget .label {
    color: var(--text);
    font-weight: 500;
}
/* measured: the app icon inked at 17 against home 18 / text 18.5; 2px of top padding puts it on
   18 (3px overshoots to 19 — whole-pixel steps, 0.5px is the floor) */
.active-window-widget .icon {
    padding-right: 7px;
    padding-top: 2px;
}
/* --- Taskbar (open apps): status mark under each icon — pinned only: none · running: a 6px dot ·
       focused or hovered: a 12px accent pill (2x the dot). The marks are PNGs (assets/taskbar-*.png) drawn as a
       bottom-centred background, because a border always spans the whole button. --- */
/* The generic .widget margin (5px top/bottom) is dropped here: with it plus the button margins the
   20px icons lost ~2px off the bottom (seen on full-bleed icons such as Windhawk's). */
.taskbar-widget {
    padding: 0 2px;
    margin: 0 1px;
}
/* ~28px square per app: 20px icon + 2px gap + 3px mark inside the 39px island (bar 42 - rail 3).
   Listed for every state: the base theme's .foreground { padding: 0 16px } otherwise widens it. */
.taskbar-widget .app-container,
.taskbar-widget .app-container.grouped,
.taskbar-widget .app-container.running,
.taskbar-widget .app-container.foreground {
    min-width: 28px;
    max-width: 28px;
    margin: 6px 2px 8px 2px; /* measured: icon rows 8-27, 3px gap, mark 31-33 -> block centre 20.5 */
    padding: 0 0 5px 0;
    border: none;
    border-radius: 0;
    background-color: transparent;
    background-repeat: no-repeat;
    background-position: bottom center;
}
.taskbar-widget .app-container.running {
    background-image: url("{{ .chezmoi.homeDir }}/.config/yasb/assets/taskbar-running.png");
}
/* hover only swaps the mark — background-color is reset because the base theme fills
   .app-container:hover with rgba(255, 255, 255, 0.15) */
.taskbar-widget .app-container.foreground,
.taskbar-widget .app-container:hover,
.taskbar-widget .app-container.running:hover,
.taskbar-widget .app-container.foreground:hover {
    background-color: transparent;
    background-image: url("{{ .chezmoi.homeDir }}/.config/yasb/assets/taskbar-focused.png");
}
.taskbar-widget .app-container.flashing {
    background-color: transparent;
    background-image: url("{{ .chezmoi.homeDir }}/.config/yasb/assets/taskbar-flashing.png");
}
/* --- Now playing: scrolling title over the album cover (media, show_thumbnail) --- */
.media-widget {
    padding: 0 2px;
}
.media-widget .widget-container {
    padding: 0;
}
.media-widget .label {
    font-size: 13px;
    font-weight: 600;
    color: #ffffff; /* sits on the cover art, so full white for contrast */
    padding: 0 10px;
}
/* Glass play button over the artwork: light glyph on a translucent disc (a dark glyph on a
   solid light disc picked up ClearType colour fringes) */
.audio-visualizer-widget {
    padding: 0 6px 0 8px;
}
.audio-visualizer-widget .audio-visualizer-canvas {
    -qproperty-fillbrush: linear-gradient(to top, #cba6f7, #f5c2e7);
}
/* --- Claude usage island --- */
.claude-usage:hover {
    background-color: var(--yasb-white-alpha-10);
}
.claude-usage .label {
    padding-left: 6px;
}
.claude-usage .stale {
    color: var(--yellow);
    padding-left: 4px;
}
.claude-usage .status.none { color: var(--green); }
.claude-usage .status.minor { color: var(--yellow); }
.claude-usage .status.major,
.claude-usage .status.critical { color: var(--red); }
/* --- System cluster --- */
.systray {
    padding: 0 4px;
}
.systray .unpinned-visibility-btn {
    font-size: 12px;
    color: var(--overlay1);
}
.systray .unpinned-visibility-btn:hover {
    color: var(--text);
}
.systray .button:hover {
    background-color: var(--yasb-white-alpha-10);
}
.volume-widget .label,
.open-meteo-widget .label {
    padding-left: 6px;
}
.notification-widget .icon.new-notification,
.notification-widget .label.new-notification {
    color: var(--blue);
}
.clock-widget .label {
    margin: 0 2px;
    font-weight: 500;
}
.clock-widget .date {
    font-weight: 500;
    color: var(--subtext0);
}
/* Popups: one flyout language — crust glass, lavender stroke */
/* ================================================================== */
/* Secondary bar readouts: tinted Segoe icon + plain value                 */
/* ================================================================== */
.cpu-widget .label,
.memory-widget .label,
.wifi-widget .label {
    padding-left: 6px;
}
.cpu-widget:hover,
.memory-widget:hover,
.wifi-widget:hover,
.volume-widget:hover,
.whkd-widget:hover {
    background-color: var(--yasb-white-alpha-10);
}
/* --- WHKD --- */
.whkd-widget .icon {
    font-size: 16px;
}
.whkd-widget:hover {
    background-color: var(--yasb-white-alpha-10);
}
/* --- WiFi menu (Material signal glyphs) --- */
/* --- Language: text chip on the bar, Windows-style list in the popup --- */
.language-widget:hover {
    background-color: var(--yasb-white-alpha-10);
}
/* --- Volume flyout: same padding rhythm as the other popups, accent sliders --- */
/* --- Claude menu: breathing room for the status dot --- */
.language-widget .icon {
    font-size: 16px;
}
.language-widget .label {
    padding-left: 6px;
}
/* ================================================================== */
/* Secondary bar: server monitor + system info group                  */
/* ================================================================== */
.server-widget:hover,
.disk-widget:hover {
    background-color: var(--yasb-white-alpha-10);
}
.server-widget .label,
.disk-widget .label {
    padding-left: 6px;
}
/* status is the online/offline/warning glyph from `icons:` (Segoe) */
.system-info .container {
    background-color: transparent;
}
.system-info .grouper-button {
    font-family: var(--icons-font);
    font-size: 10px;
    color: var(--overlay1);
    background-color: transparent;
    border: none;
    padding: 0 4px;
    margin: 6px 2px;
    border-radius: 3px;
}
.system-info .grouper-button:hover {
    color: var(--text);
    background-color: var(--yasb-white-alpha-10);
}

/* ================================================================== */
/* Colour map — one Mocha colour per widget. Labels share one text colour; on the secondary  */
/* readouts the colour covers icon + value, except wifi/volume (icon only).                  */
/* ================================================================== */
.widget .label { color: var(--text); }
.home-widget .icon { color: var(--lavender); }
.komorebi-active-layout .label { color: var(--subtext1); }
/* primary right: icon only */
.claude-usage .icon {
    font-family: var(--icons-font-fallback); /* Material asterisk ~ Claude's starburst */
    color: var(--peach);
}
.open-meteo-widget .icon { color: var(--yellow); }
.language-widget .icon { color: var(--teal); }
.notification-widget .icon { color: var(--pink); }
.control-center-widget .icon { color: var(--sky); }
/* secondary right */
.whkd-widget .icon { color: var(--lavender); }
.server-widget .icon, .server-widget .label { color: var(--green); }
.cpu-widget .icon, .cpu-widget .label { color: var(--sapphire); }
.memory-widget .icon, .memory-widget .label { color: var(--maroon); }
.disk-widget .icon, .disk-widget .label { color: var(--peach); }
.wifi-widget .icon { color: var(--mauve); }
.volume-widget .icon { color: var(--teal); }
.server-widget .warning .icon, .server-widget .warning .label { color: var(--yellow); }
.server-widget .error .icon, .server-widget .error .label { color: var(--red); }
.notification-widget .icon.new-notification { color: var(--blue); }

/* ================================================================== */
/* Popups: yasb wiki "Example Style" blocks, verbatim (popup selectors only) */
/* ================================================================== */
/* --- Home --- */
.home-menu {
    background-color:rgba(17, 17, 27, 0.5); 
}
.home-menu .menu-item {
    padding: 6px 48px 7px 16px;
    font-size: 12px;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    color: var(--text); 
    font-weight: 600;
}
.home-menu .menu-item:hover {
    background-color:rgba(128, 130, 158, 0.15);
    color: #fff;
}
.home-menu .separator {
    max-height: 1px;
    background-color:rgba(128, 130, 158, 0.3);
}
/* --- Komorebi-Layout --- */
.komorebi-layout-menu {
    background-color:rgba(17, 17, 27, 0.4)
}
.komorebi-layout-menu .menu-item {
    padding: 8px 16px;
    font-size: 12px;
    color: #cdd6f4; 
    font-weight: 600;
}
.komorebi-layout-menu .menu-item-icon {
    color: #cdd6f4;
    font-size: 16px;
}
.komorebi-layout-menu .menu-item-text {
    font-family: 'Segoe UI';
    padding-left:4px;
    font-size: 12px;
}
.komorebi-layout-menu .menu-item:hover {
    background-color:rgba(128, 130, 158, 0.15);
    color: #fff;
}
.komorebi-layout-menu .separator {
    max-height: 1px;
    background-color: rgba(255, 255, 255, 0.15);
}
/* --- Taskbar --- */
.taskbar-preview {}
.taskbar-preview .preview-item {}
.taskbar-preview .preview-item:hover {}
.taskbar-preview .header {}
.taskbar-preview .header .title {}
.taskbar-preview .close-button {}
.taskbar-preview {
    border-radius: 8px;
    background-color: rgba(38, 38, 38, 0.8); 
}
.taskbar-preview .preview-item {
    background-color: rgba(38, 38, 38, 0.01); 
}
.taskbar-preview .preview-item:hover {
    background-color: rgba(255, 255, 255, 0.1); 
