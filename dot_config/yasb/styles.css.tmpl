/* --- Customisations on top of the wiki popups --- */
/* Wiki names "JetBrainsMono NFP"; Qt only matches the full family name, so those rules use
   var(--icons-font-fallback) ("JetBrainsMono Nerd Font Propo") instead. Media Lite play: a dark glyph on a solid white disc picks up ClearType colour
   fringes, so use a light glyph on a translucent disc instead. */
.media-lite-menu .btn.play {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.22);
}
.media-lite-menu .btn.play:hover {
    background-color: rgba(255, 255, 255, 0.32);
}
/* Segoe codepoints the wiki sheet renders with a Nerd Font: sunrise/sunset glyphs (yasb defaults)
   the keyboard-layout glyph () and the notifications `default` bell (, reused in the empty menu) */
.open-meteo-card-today .label.sunrisesunset-icon,
.language-menu .language-item .icon,
.notification-menu .contents .empty .icon {
    font-family: "Segoe Fluent Icons";
}
/* Material layout glyphs in the komorebi layout menu. Propo glyphs differ in width, so a fixed
   icon column keeps every label starting at the same x. */
.komorebi-layout-menu .menu-item-icon {
    font-family: var(--icons-font-fallback);
    min-width: 22px;
    max-width: 22px;
}
