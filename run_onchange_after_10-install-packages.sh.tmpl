#!/bin/sh
# Bootstrap, part 1 of 2: OS packages, mise tools, tmux/zsh plugins, git wiring. Re-runs
# whenever this file's rendered content changes (e.g. you toggle a profile or add a package).
# Claude Code + its plugins/skills are part 2 (run_onchange_after_20-install-claude), so
# declaring a plugin doesn't re-run mise install. `after_` => runs once
# all dotfiles are applied, so mise's conf.d/*.toml are in place when `mise install`
# runs.
set -eu

# --- base packages: install only what's missing. btop→bottom and tree→eza are handled
#     by mise + shell aliases now, so they're no longer installed via brew/apt. ---
{{ if eq .chezmoi.os "darwin" -}}
command -v brew >/dev/null 2>&1 || /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
# git/curl ship with macOS — only install if somehow absent.
command -v git  >/dev/null 2>&1 || brew install git
command -v curl >/dev/null 2>&1 || brew install curl
{{ if .tmux }}command -v tmux >/dev/null 2>&1 || brew install tmux{{ end }}
# mole — macOS cleanup/optimization CLI (macOS only).
command -v mole >/dev/null 2>&1 || brew install mole
# WezTerm nightly (the cross-OS terminal, ~/.wezterm.lua) + the font family it names.
# `brew upgrade --cask wezterm@nightly --greedy` pulls a newer build.
[ -d /Applications/WezTerm.app ] || brew install --cask wezterm@nightly
[ -f "$HOME/Library/Fonts/JetBrainsMonoNLNerdFont-Regular.ttf" ] || brew install --cask font-jetbrains-mono-nerd-font
{{ if .wm }}
# macOS window manager (yabai + skhd) from the upstream tap — install only what's missing
# so a re-run (cza after any fingerprint change) doesn't reinstall/upgrade them each time.
command -v yabai >/dev/null 2>&1 || brew install koekeishiya/formulae/yabai
command -v skhd  >/dev/null 2>&1 || brew install koekeishiya/formulae/skhd
skhd --start-service || true
echo "[wm] yabai installed — run 'yabai --start-service' (needs SIP setup; see the yabai wiki)"
{{ end }}
{{ if .apps -}}
# Essential GUI apps (the `apps` profile; list = .chezmoidata.yaml appList.darwin).
for _c in {{ .appList.darwin | join " " }}; do
  brew list --cask "$_c" >/dev/null 2>&1 || brew install --cask "$_c"
done
{{ end -}}
{{ else if eq .chezmoi.os "linux" -}}
# Batch a single apt-get for whatever is missing (skip the update entirely if nothing is).
_pkgs=""
command -v git  >/dev/null 2>&1 || _pkgs="$_pkgs git"
command -v curl >/dev/null 2>&1 || _pkgs="$_pkgs curl"
# zsh: this repo ships ~/.zshrc + the zsh/conf.d stack + sheldon, so the shell itself has to
# exist. macOS already ships zsh; Debian/Ubuntu do not.
command -v zsh  >/dev/null 2>&1 || _pkgs="$_pkgs zsh"
{{ if .tmux }}command -v tmux >/dev/null 2>&1 || _pkgs="$_pkgs tmux"{{ end }}
{{ if .develop }}command -v make >/dev/null 2>&1 || _pkgs="$_pkgs make"{{ end }}
{{ if .apps }}{{ range .appList.linux }}dpkg -s {{ . }} >/dev/null 2>&1 || _pkgs="$_pkgs {{ . }}"
{{ end }}{{ end -}}
if [ -n "$_pkgs" ]; then sudo apt-get update -y && sudo apt-get install -y $_pkgs; fi
{{ end -}}

# chsh is interactive (it prompts for a password), so it is NOT run here — just say so once.
# SHELL can be unset in a non-interactive run, and `set -u` makes ${SHELL##*/} fatal, so default it.
_login_sh="${SHELL:-}"
if command -v zsh >/dev/null 2>&1 && [ "${_login_sh##*/}" != "zsh" ]; then
  echo "[shell] login shell is ${_login_sh:-unset} — run: chsh -s \"$(command -v zsh)\"  (then re-login)"
fi
unset _login_sh

# ~/.local/bin holds self-installed tools (sheldon, mise).
export PATH="$HOME/.local/bin:$PATH"

# --- sheldon (zsh plugin manager) — idempotent; --force overwrites on upgrade ---
command -v sheldon >/dev/null 2>&1 || \
  curl --proto '=https' -fLsS https://rossmacarthur.github.io/install/crate.sh | \
    bash -s -- --force --repo rossmacarthur/sheldon --to "$HOME/.local/bin"

# --- mise (runtimes + CLI tools, cross-platform — drives the tools/develop profiles) ---
command -v mise >/dev/null 2>&1 || \
  curl --proto '=https' --tlsv1.2 -fsSL https://mise.run | sh

{{ if .tmux -}}
# --- tmux plugins (TPM) — server-free install --------------------------------
# A TPM "install" is just `git clone` into ~/.tmux/plugins/<name>, so we clone the
# plugins directly instead of driving tmux. We deliberately DON'T use TPM's own
# bin/install_plugins: it needs a live tmux server that has sourced the config (to
# read TMUX_PLUGIN_MANAGER_PATH), and during a non-interactive bootstrap that path
# was the source of two bugs —
#   1. a session-less `tmux start-server` exits before TPM can query it, so TPM
#      aborted with "not configured" and installed ZERO plugins (silently, because
#      stderr was sent to /dev/null); and
#   2. starting a server on the default socket left a stale server behind, which
#      then made plain `tmux` abort with "server exited unexpectedly" after the
#      next tmux upgrade (old server vs newly-installed client).
# Cloning needs no server, touches no socket, never hides errors, and is safe to
# re-run. TPM still manages updates at runtime via `prefix + I` / `prefix + U`.
tpm_dir="$HOME/.tmux/plugins"
mkdir -p "$tpm_dir"
[ -d "$tpm_dir/tpm" ] || \
  git clone --depth 1 https://github.com/tmux-plugins/tpm "$tpm_dir/tpm"
# Clone every `set -g @plugin 'owner/repo'` (or full git URL) declared in the config
# that isn't present yet. A failed clone doesn't stop the other plugins or the rest of the
# bootstrap, but fails the script at the end (so chezmoi re-runs it on the next apply).
sed -n "s/^[[:space:]]*set[^@]*@plugin[[:space:]]*['\"]\([^'\"]*\)['\"].*/\1/p" \
      "$HOME/.tmux.conf" 2>/dev/null \
  | { rc=0; while IFS= read -r plugin; do
      [ -n "$plugin" ] || continue
      name=${plugin##*/}; name=${name%.git}
      if [ -d "$tpm_dir/$name" ]; then continue; fi
      case "$plugin" in
        *://*) url="$plugin" ;;
        *)     url="https://github.com/$plugin" ;;
      esac
      echo "[tmux] installing plugin: $name"
      git clone --depth 1 "$url" "$tpm_dir/$name" \
        || { echo "[tmux] clone failed for $plugin" >&2; rc=1; }
    done; exit $rc; } || tmux_failed=1
{{ end -}}

# --- install tools/runtimes declared in ~/.config/mise/conf.d/*.toml, lock sheldon ---
# --cd "$HOME": mise only auto-discovers the global conf.d/*.toml when CWD is inside the home
# tree; chezmoi may run this script from elsewhere, so anchor it at $HOME or nothing installs.
# A logged-in gh's token lifts mise's GitHub API limit (60/h unauthenticated) — same as the
# .ps1's Set-GitHubToken. gh is itself a mise tool, so this only helps on a re-run.
[ -n "${GITHUB_TOKEN:-}" ] || { GITHUB_TOKEN=$(mise --cd "$HOME" exec -- gh auth token 2>/dev/null) && export GITHUB_TOKEN; } || unset GITHUB_TOKEN
mise --cd "$HOME" install --yes

{{ if .tools -}}
# delta: point git at the tracked delta config via include.path (idempotent), leaving
# ~/.gitconfig's identity/signing untouched. Only when the tools profile (delta) is on.
if command -v git >/dev/null 2>&1; then
  _delta_inc="${XDG_CONFIG_HOME:-$HOME/.config}/git/delta.gitconfig"
  git config --global --get-all include.path 2>/dev/null | grep -qxF "$_delta_inc" \
    || git config --global --add include.path "$_delta_inc"
  unset _delta_inc
  # codegraph: keep each repo's .codegraph/ index out of `git status` via git's default global
  # excludes file (unmanaged — Claude Code appends to it too), idempotently.
  _gi="${XDG_CONFIG_HOME:-$HOME/.config}/git/ignore"
  grep -qxF '.codegraph/' "$_gi" 2>/dev/null || { mkdir -p "${_gi%/*}"; echo '.codegraph/' >> "$_gi"; }
  unset _gi
fi
{{ end -}}

# `lock` (not `--update`): fetch missing plugins only; updating them is the user's.
sheldon lock

[ -z "${tmux_failed:-}" ] || { echo "[bootstrap] part 1 had failures; fix them, then re-run chezmoi apply" >&2; exit 1; }
