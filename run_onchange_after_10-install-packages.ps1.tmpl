# Windows bootstrap, part 1 of 2: scoop + mise + wm + profile wiring (the analogue of
# run_onchange_after_10-install-packages.sh.tmpl). Claude Code + plugins/skills are part 2,
# run_onchange_after_20-install-claude.ps1.tmpl. chezmoi runs this
# via the [interpreters.ps1] command set in .chezmoi.toml.tmpl. Re-runs automatically
# whenever this file's rendered content changes. tmux / sheldon / TPM are Unix-only
# and intentionally skipped here.
$ErrorActionPreference = 'Stop'

# This script runs under WinPS 5.1 ([interpreters.ps1]) but INHERITS PSModulePath from whoever
# launched chezmoi. From pwsh 7 that list starts with pwsh's own module dirs, and 5.1 then
# autoloads pwsh 7's Microsoft.PowerShell.Security and dies ("Get-ExecutionPolicy ... module
# could not be loaded") at the first cmdlet from it - the scoop installer. It only bites when
# pwsh's $PSHOME is readable: an MSI install (Program Files\PowerShell\7, e.g. GitHub's
# runners) does, the Store/winget one (WindowsApps) is ACL-hidden from 5.1 and silently
# skipped. Reset to 5.1's own list before any module loads.
$env:PSModulePath = @(
  (Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'WindowsPowerShell\Modules')
  [Environment]::GetEnvironmentVariable('PSModulePath', 'Machine')
) -join ';'

{{ template "bootstrap-steps.ps1" . }}

# --- preflight: stop BEFORE changing anything on what no later step can work around ---
# Elevated: scoop's installer refuses (except under CI, as here) by `break`-ing out of this
# script mid-way, with nothing installed and no clear reason.
$principal = [Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()
if ($principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator) -and -not $env:CI) {
  Write-Host "[bootstrap] Running as administrator - scoop refuses that. Open a NORMAL terminal and run: chezmoi apply" -ForegroundColor Red
  exit 1
}
# pwsh 7 comes from winget's MSI (see below) at this FIXED path. On a new Windows account winget
# only works once the Store has updated "App Installer" (minutes to hours after first logon) - no
# fallback to a scoop pwsh: stop, let the user update it, re-run.
$PwshExe = Join-Path $env:ProgramFiles 'PowerShell\7\pwsh.exe'
if (-not (Test-Path $PwshExe)) {
  $wingetOk = (Get-Command winget -ErrorAction SilentlyContinue) -and
              (& { $ErrorActionPreference = 'Continue'; winget --version 2>&1 | Out-Null; $LASTEXITCODE -eq 0 })
  if (-not $wingetOk) {
    Write-Host "[bootstrap] winget isn't ready (needed for PowerShell 7). Open Microsoft Store > Library > Get updates (or install 'App Installer'), then run: chezmoi apply" -ForegroundColor Red
    exit 1
  }
}

# WinPS 5.1 defaults to Restricted on Windows clients: its profile and scoop's .ps1 shims are then
# blocked in every Windows PowerShell window (this script runs with -ExecutionPolicy Bypass, so it
# never notices). CurrentUser scope needs no admin; pwsh 7 keeps its own RemoteSigned default.
# Set-ExecutionPolicy reports the (still applied) setting as an error while Process=Bypass
# overrides it, hence the catch + re-read.
if ((Get-ExecutionPolicy -Scope CurrentUser) -eq 'Undefined' -and
    (Get-ExecutionPolicy -Scope LocalMachine) -in 'Undefined', 'Restricted', 'AllSigned') {
  try { Set-ExecutionPolicy RemoteSigned -Scope CurrentUser -Force -ErrorAction Stop } catch { }
  if ((Get-ExecutionPolicy -Scope CurrentUser) -ne 'RemoteSigned') {
    Write-Host "[policy] could not set RemoteSigned for CurrentUser (Group Policy?) - Windows PowerShell 5.1 may block scripts."
  }
}

# --- env every later step + the PowerShell profile rely on (persisted for the user) ---
$LocalBin = Join-Path $HOME '.local\bin'
New-Item -ItemType Directory -Force -Path $LocalBin | Out-Null
$XdgConfig = Join-Path $HOME '.config'

function Add-UserPath([string]$Dir) {
  $current = [Environment]::GetEnvironmentVariable('Path', 'User')
  if ($current -notlike "*$Dir*") {
    [Environment]::SetEnvironmentVariable('Path', "$Dir;$current", 'User')
  }
  if ($env:Path -notlike "*$Dir*") { $env:Path = "$Dir;$env:Path" }
}

# ~/.local/bin holds chezmoi (the one-liner installs it there) + other self-installed
# tools. It is NOT on PATH by default on Windows, so persist it.
Add-UserPath $LocalBin

# XDG_CONFIG_HOME so mise (and other XDG-aware tools) read ~/.config/mise/conf.d —
# the SAME manifests used on macOS/Linux. Without this mise looks in %APPDATA%.
[Environment]::SetEnvironmentVariable('XDG_CONFIG_HOME', $XdgConfig, 'User')
$env:XDG_CONFIG_HOME = $XdgConfig

# NOTE: deliberately DO NOT set MISE_GLOBAL_CONFIG_FILE / MISE_CONFIG_DIR. They are redundant
# (mise already defaults to ~/.config/mise) AND they stop mise auto-discovering the conf.d/*.toml
# manifests when CWD is outside $HOME. The shell profiles unset them; see dot_config/mise/AGENTS.md.

# Window-manager config homes — point komorebi/whkd/yasb at ~/.config/<tool>. These
# MUST be persisted (User scope): the WM apps launch at startup, outside any shell
# profile. komorebi defaults to ~/komorebi.json and whkd to ~/.config/whkdrc, so without
# these the chezmoi-managed configs under ~/.config/<tool> are not read.
foreach ($wm in 'komorebi','whkd','yasb') {
  $home_ = Join-Path $XdgConfig $wm
  $var = $wm.ToUpper() + '_CONFIG_HOME'
  [Environment]::SetEnvironmentVariable($var, $home_, 'User')
  Set-Item "env:$var" $home_
}

# --- install roots: SCOOP + MISE_DATA_DIR (User scope, prompted by `chezmoi init`) ---
# Set BEFORE installing: the scoop installer and mise read them. An existing install elsewhere
# wins — scoop can't be moved in place (shims/junctions hold absolute paths), and a new
# MISE_DATA_DIR would silently re-download every tool — so warn and keep it.
function Resolve-Root([string]$Name, [string]$Want, [string]$Have) {
  $Want = $Want -replace '/', '\'
  if ($Have -and ($Have.TrimEnd('\') -ne $Want.TrimEnd('\'))) {
    Write-Host "[$Name] already at $Have (configured: $Want) - keeping it."
    return $Have
  }
  $Want
}
$scoopCmd = Get-Command scoop -ErrorAction SilentlyContinue
$ScoopDir = Resolve-Root 'scoop' '{{ .scoopDir | default (printf "%s/.local/share/scoop" .chezmoi.homeDir) }}' $(if ($scoopCmd) { Split-Path (Split-Path $scoopCmd.Source) })
$MiseDir  = Resolve-Root 'mise'  '{{ .miseDataDir | default (printf "%s/.local/share/mise" .chezmoi.homeDir) }}' ([Environment]::GetEnvironmentVariable('MISE_DATA_DIR', 'User'))
foreach ($kv in @(@('SCOOP', $ScoopDir), @('MISE_DATA_DIR', $MiseDir))) {
  [Environment]::SetEnvironmentVariable($kv[0], $kv[1], 'User')
  Set-Item "env:$($kv[0])" $kv[1]
}

# --- scoop (package manager) — installs per-user; must NOT run elevated ---
if (-not $scoopCmd) {
  Invoke-Step 'scoop' { Invoke-RestMethod -Uri 'https://get.scoop.sh' | Invoke-Expression }
  # Nothing below works without it.
  if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) { Complete-Bootstrap 'part 1'; exit 1 }
}
Add-UserPath (Join-Path $ScoopDir 'shims')
{{ if .sshd -}}
# sshd profile only (an SSH server). no_junction, BEFORE any install: shims and PATH point at apps\<app>\<version>, not the
# apps\<app>\current junction. sshd runs with RedirectionGuard (since KB5074105), which won't
# follow a junction a non-admin created, so every shim through `current` fails over SSH
# ("Could not create process", ScoopInstaller/Scoop#6594). Apps installed with junctions are
# reset once to rewrite their shims/PATH; the old `current` junctions stay, unused.
if ((scoop config no_junction) -ne $true) { Invoke-Step 'scoop no_junction' { scoop config no_junction true } }
if (Get-ChildItem (Join-Path $ScoopDir 'shims\*.shim') -ErrorAction SilentlyContinue |
    Where-Object { (Get-Content $_.FullName -Raw) -match '\\current\\' }) {
  Invoke-Step 'scoop reset (no_junction)' { scoop reset * }
}
{{- end }}

# git via scoop (per-user, no elevation); curl ships with Windows 10+.
if (-not (Get-Command git -ErrorAction SilentlyContinue)) { Invoke-Step 'git' { scoop install git } }
# Claude Code runs its shell tool in Git Bash, found from git.exe's location - scoop's git.exe is
# a shim in <scoop>\shims, so that lookup misses bash. Point it there when unset, or when it
# still points into scoop's git at another path (the old `current` junction — unreachable over
# SSH — or a previous version); a path outside scoop is the user's and stays.
# A git from elsewhere (Git for Windows, a CI runner) has no scoop prefix ('' — and both
# Join-Path and Test-Path throw on ''): skip, Claude Code finds that git's bash itself.
$gitPrefix = "$(scoop prefix git 6>$null)"
$gitBash = if ($gitPrefix) { Join-Path $gitPrefix 'bin\bash.exe' }
$curBash = [Environment]::GetEnvironmentVariable('CLAUDE_CODE_GIT_BASH_PATH', 'User')
if ($gitBash -and (Test-Path $gitBash) -and (-not $curBash -or ($curBash -like "$ScoopDir\apps\git\*" -and $curBash -ne $gitBash))) {
  [Environment]::SetEnvironmentVariable('CLAUDE_CODE_GIT_BASH_PATH', $gitBash, 'User')
}

# pwsh 7 — the shell the managed profile targets (this bootstrap itself runs under WinPS 5.1).
# winget's MSI (`--installer-type wix`), NOT its default MSIX: the MSIX lives in a versioned
# WindowsApps\Microsoft.PowerShell_7.x.y.z_... dir that moves on every update, while the MSI
# installs to the FIXED $env:ProgramFiles\PowerShell\7 and puts it on the Machine PATH (ahead of
# any MSIX alias on the user PATH). Machine scope = one UAC prompt, like the VC++ runtimes.
# Guarded on that path, not `Get-Command pwsh`, so an MSIX/Store pwsh doesn't count. [cd] and
# Claude's statusLine still call bare `pwsh` (AGENTS.md "never bake pwsh's path"); it now
# resolves here. winget readiness was checked in the preflight.
if (-not (Test-Path $PwshExe)) {
  Invoke-Step 'pwsh' {
    winget install --id Microsoft.PowerShell --exact --source winget --installer-type wix --scope machine `
      --silent --accept-package-agreements --accept-source-agreements --disable-interactivity
    # Success = the file exists (winget's exit code alone doesn't prove which installer ran).
    if (-not (Test-Path $PwshExe)) { throw "pwsh MSI not at $PwshExe" }
    $global:LASTEXITCODE = 0
  } 'accept the UAC prompt, then chezmoi apply'
}
# A Store/MSIX pwsh left beside the MSI keeps a `pwsh` alias in ...\WindowsApps that can come first
# on PATH and shadow the fixed one. NOT removed here: this script usually runs FROM that pwsh, and
# removing a running package can kill the terminal mid-install - so only say how.
if ((Test-Path $PwshExe) -and (Get-AppxPackage Microsoft.PowerShell -ErrorAction SilentlyContinue)) {
  Write-Host "[pwsh] a Store/MSIX PowerShell is also installed and may shadow $PwshExe. Close every pwsh window, then from Windows PowerShell run: Get-AppxPackage Microsoft.PowerShell | Remove-AppxPackage"
}

# Visual C++ 2015-2022 runtimes (x64 + x86 for 32-bit apps; + arm64 on ARM) — most native Windows
# binaries (mise's tools, runtimes) need vcruntime140.dll, and mise recommends it. From winget, not
# scoop: it's a system component either way (UAC prompt; scoop's vcredist2022 only runs this same
# installer and says to uninstall the wrapper after), and winget keeps it upgradable. `winget
# install` on an installed package UPGRADES it, so every run leaves the newest one; "already
# current" exits 0x8A15002B (no applicable upgrade) and 0x8A150061 (already installed, older
# winget) — both success. Without winget, a box that already has the runtime is fine as is.
$vcArch = @('x64', 'x86') + $(if ($env:PROCESSOR_ARCHITECTURE -eq 'ARM64') { @('arm64') } else { @() })
foreach ($a in $vcArch) {
  $vcKey = "HKLM:\SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\$a"
  $vcHave = (Get-ItemProperty $vcKey -ErrorAction SilentlyContinue).Installed -or
            (Get-ItemProperty ($vcKey -replace 'SOFTWARE\\', 'SOFTWARE\WOW6432Node\') -ErrorAction SilentlyContinue).Installed
  if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    if (-not $vcHave) { $script:Failed.Add("vcredist $a"); Write-Host "[vcredist $a] FAILED - winget missing" -ForegroundColor Red }
    continue
  }
  Invoke-Step "vcredist $a" {
    winget install --id "Microsoft.VCRedist.2015+.$a" --exact --source winget --silent `
      --accept-package-agreements --accept-source-agreements --disable-interactivity
    if ($LASTEXITCODE -in -1978335189, -1978335135) { $global:LASTEXITCODE = 0 }
  } 'accept the UAC prompt (system-wide runtime)'
}

# --- mise (runtimes + CLI tools, cross-platform — drives the tools/develop profiles) ---
if (-not (Get-Command mise -ErrorAction SilentlyContinue)) { Invoke-Step 'mise' { scoop install mise } }
# mise's shims, for what runs outside the profile's `mise env` injection (GUI apps, tasks).
Add-UserPath (Join-Path $MiseDir 'shims')

# Windows-only scoop extras, guarded on the command. gsudo (also ships a `sudo` shim; where
# Windows' own sudo is enabled, System32\sudo.exe wins — `gsudo` always works). A font ships NO
# command, so that one is guarded on `scoop list` (through Out-String: Select-String on its
# objects never matches). The font is JetBrainsMono-NF (nerd-fonts bucket), NOT -NF-Mono: every
# consumer names the family `JetBrainsMonoNL Nerd Font` (WezTerm, yasb's Qt CSS, the
# komorebi bar as `JetBrainsMonoNL NF`), and -NF-Mono only registers `… Nerd Font Mono` — Qt
# then falls back to Tahoma.
# Fonts install per-user (HKCU) — no elevation.
if (-not (Get-Command openssl -ErrorAction SilentlyContinue)) { Invoke-Step 'openssl' { scoop install openssl } }
# starship: the pwsh prompt — only Windows uses it (Unix: powerlevel10k), so scoop, not mise.
# Guarded on `scoop list`: a leftover mise copy on PATH must not count.
if ((scoop list 2>$null | Out-String) -notmatch '(?im)^\s*starship\b') { Invoke-Step 'starship' { scoop install starship } }
if (-not (Get-Command gsudo   -ErrorAction SilentlyContinue)) { Invoke-Step 'gsudo' { scoop install gsudo } }
# ssh = Windows' built-in OpenSSH (pairs with the ssh-agent service; Windows Update patches it),
# not scoop's. Enabling the optional feature needs admin, so only say how.
if (-not (Test-Path "$env:SystemRoot\System32\OpenSSH\ssh.exe")) {
  Write-Host "[ssh] Windows OpenSSH client missing - as admin: Add-WindowsCapability -Online -Name OpenSSH.Client~~~~0.0.1.0"
}
# Guard on the FONT being installed (its .ttf in the per-user or system Fonts dir), not on scoop's
# record: once a font file there is registered, Windows' font service holds it open, so a retry
# after a partial install (or over a hand-installed copy) dies with "The process cannot access
# the file ... because it is being used by another process" — every time.
$fontFile = 'JetBrainsMonoNLNerdFont-Regular.ttf'
$fontHave = (Test-Path (Join-Path $env:LOCALAPPDATA "Microsoft\Windows\Fonts\$fontFile")) -or
            (Test-Path (Join-Path $env:SystemRoot "Fonts\$fontFile"))
if (-not $fontHave) {
  Invoke-Step 'font' {
    if ((scoop bucket list 2>$null | Out-String) -notmatch 'nerd-fonts') { scoop bucket add nerd-fonts }
    scoop install JetBrainsMono-NF
  }
}
# WezTerm nightly (the cross-OS terminal, ~/.wezterm.lua). Its manifest's version is the literal
# `nightly`, so `scoop update` never sees a new build — `scoop update wezterm-nightly -f` does.
if (-not (Get-Command wezterm -ErrorAction SilentlyContinue)) {
  Invoke-Step 'wezterm' {
    if ((scoop bucket list 2>$null | Out-String) -notmatch 'versions') { scoop bucket add versions }
    scoop install versions/wezterm-nightly
  }
}

# --- PSFzf (fzf <-> PSReadLine chords: Ctrl+t / Ctrl+r / Alt+c) ---
# PSReadLine itself needs nothing - it ships with pwsh 7 (2.4.x; WinPS 5.1's 2.0.0 is why
# the profile version-gates PredictionSource). PSFzf comes from scoop's extras bucket: a scoop
# psmodule lands in <scoop>\modules, which scoop adds to the USER PSModulePath, so pwsh 7 and
# 5.1 both see it (no Install-PSResource-inside-pwsh dance). A module ships no command, so
# guard on `scoop list` — through Out-String: Select-String on its objects never matches.
if ((scoop list 2>$null | Out-String) -notmatch '(?im)^\s*psfzf\b') {
  Invoke-Step 'psfzf' {
    if ((scoop bucket list 2>$null | Out-String) -notmatch 'extras') { scoop bucket add extras }
    scoop install psfzf
  }
}

{{ if .develop -}}
# make: Windows-only gap (Unix gets it from the OS), so scoop — the `develop` profile.
if (-not (Get-Command make -ErrorAction SilentlyContinue)) { Invoke-Step 'make' { scoop install make } }
{{ end -}}

{{ if and .apps .appList.windows -}}
# --- Essential GUI apps (the `apps` profile; list = .chezmoidata.yaml appList.windows) ---
# winget, not scoop: installers/services that update themselves. --no-upgrade leaves an
# installed app alone; "already installed" exits 0x8A150061 (or 0x8A15002B) — success.
foreach ($id in @('{{ .appList.windows | join "','" }}')) {
  Invoke-Step $id {
    winget install --id $id --exact --source winget --no-upgrade --silent `
      --accept-package-agreements --accept-source-agreements --disable-interactivity
    if ($LASTEXITCODE -in -1978335189, -1978335135) { $global:LASTEXITCODE = 0 }
  }
}
{{ end -}}

{{ if .tmux -}}
# --- psmux (tmux for Windows; reads the same ~/.tmux.conf) — the `tmux` profile ---
# Ships psmux/pmux/tmux.exe shims. Plugins are copied like the Unix TPM clones (no live server,
# no Prefix+I): one shallow clone of the psmux-plugins monorepo, then each missing plugin dir
# into ~/.psmux/plugins/ (their plugin.conf files hardcode that path). Keep this list in sync
# with the Windows @plugin lines in dot_tmux.conf.tmpl.
if (-not (Get-Command psmux -ErrorAction SilentlyContinue)) { Invoke-Step 'psmux' { scoop install psmux } }
$psmuxPlugins = Join-Path $HOME '.psmux\plugins'
$wanted = 'ppm','psmux-resurrect','psmux-continuum'
$missing = $wanted | Where-Object { -not (Test-Path (Join-Path $psmuxPlugins $_)) }
if ($missing) {
  $tmp = Join-Path $env:TEMP "psmux-plugins-$PID"
  Invoke-Step 'psmux plugins' {
    git clone --quiet --depth 1 https://github.com/psmux/psmux-plugins.git $tmp
    if ($LASTEXITCODE -ne 0) { return }
    New-Item -ItemType Directory -Force -Path $psmuxPlugins | Out-Null
    foreach ($p in $missing) { Copy-Item -Recurse -ErrorAction Stop (Join-Path $tmp $p) (Join-Path $psmuxPlugins $p) }
    Write-Host "[psmux] plugins installed: $($missing -join ', ')"
  }
  Remove-Item -Recurse -Force $tmp -ErrorAction SilentlyContinue
}
{{   if .sshd -}}
# sshd profile: restore the saved psmux sessions at logon (with autologon that is right after
# boot), so an SSH login finds them, Claude conversations resumed, already running. A logon
# task for this user needs no elevation; a boot/S4U one would, and runs without the user's
# credentials. Re-registered only when missing or its action differs.
$restoreArgs = "-NoLogo -NoProfile -WindowStyle Hidden -File `"$HOME\.psmux\tm-restore.ps1`""
$restoreTask = Get-ScheduledTask -TaskName 'psmux-restore' -ErrorAction SilentlyContinue
if (-not $restoreTask -or $restoreTask.Actions[0].Arguments -ne $restoreArgs) {
  Invoke-Step 'psmux-restore task' {
    Register-ScheduledTask -TaskName 'psmux-restore' -Force -ErrorAction Stop `
      -Action (New-ScheduledTaskAction -Execute 'pwsh.exe' -Argument $restoreArgs) `
      -Trigger (New-ScheduledTaskTrigger -AtLogOn -User $env:USERNAME) `
      -Settings (New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -ExecutionTimeLimit (New-TimeSpan -Minutes 10)) | Out-Null
  }
}
{{   end -}}
{{ end -}}

# --- install tools/runtimes declared in ~/.config/mise/conf.d/*.toml ---
# --cd $HOME: mise only auto-discovers the global conf.d/*.toml when CWD is inside the home
# tree; chezmoi may run this script from elsewhere, so anchor it at $HOME or nothing installs.
if (Get-Command mise -ErrorAction SilentlyContinue) {
  Set-GitHubToken  # again: mise's shims (a gh from an earlier run) are on PATH only from here
  Invoke-Step 'mise install' { mise --cd $HOME install --yes } $GhHint
}

{{ if .tools -}}
# delta: wire git via include.path (idempotent); identity stays in the unmanaged config.
if (Get-Command git -ErrorAction SilentlyContinue) {
  $deltaInc = Join-Path $HOME '.config/git/delta.gitconfig'
  if (((git config --global --get-all include.path) 2>$null) -notcontains $deltaInc) {
    git config --global --add include.path $deltaInc
  }
  # git over Windows' OpenSSH, so it shares the ssh-agent service's keys (Git's bundled ssh
  # doesn't talk to it). Only if unset — a machine-local choice wins.
  $winSsh = "$env:SystemRoot\System32\OpenSSH\ssh.exe"
  if ((Test-Path $winSsh) -and -not ((git config --global --get core.sshCommand) 2>$null)) {
    git config --global core.sshCommand ($winSsh -replace '\\', '/')
  }
  # codegraph: keep each repo's .codegraph/ index out of `git status` via git's default global
  # excludes file (unmanaged — Claude Code appends to it too), idempotently.
  $gitIgnore = Join-Path $HOME '.config/git/ignore'
  if (-not ((Test-Path $gitIgnore) -and (Select-String -Path $gitIgnore -SimpleMatch -Pattern '.codegraph/' -Quiet))) {
    Add-Content -Path $gitIgnore -Value '.codegraph/'
  }
}
{{ end -}}

{{ if .wm -}}
# --- Windows tiling window manager (komorebi + whkd + yasb) — the `wm` profile,
#     analogue of the macOS yabai/skhd block. These live in scoop's extras bucket. ---
# Install only what's missing so a re-run (cza) doesn't reinstall/upgrade each time.
$installed = scoop list 2>$null | Out-String
foreach ($app in 'komorebi','whkd','yasb') {
  if ($installed -notmatch "(?im)^\s*$app\b") {
    Invoke-Step $app {
      if ((scoop bucket list 2>$null | Out-String) -notmatch 'extras') { scoop bucket add extras }
      scoop install $app
    }
  }
}
# Autostart komorebi + whkd at login: komorebi's own `enable-autostart`, a shell:startup
# komorebi.lnk running komorebic-no-console.exe (no console, so no flash at login). Verified
# after a reboot: it tiles, whkd runs. The July 2026 logon task + autostart.ps1 launcher existed
# because scoop's shims weren't on the login PATH then (`komorebic start` does `Start-Process
# komorebi.exe`); they're on the User PATH now (Add-UserPath above). Restart (whkd alt+ctrl+o,
# yasb reload) = `komorebic stop` + `komorebic-no-console start` in its own process. Never `conhost.exe --headless` a logon launcher:
# it dies at LOGON with 0x80070003 while working on demand.
if (Get-Command komorebic -ErrorAction SilentlyContinue) {
  # Community app rules (komorebi.json's app_specific_configuration_path): downloaded, NOT
  # tracked — the tracked copy only ever went stale. Writes $KOMOREBI_CONFIG_HOME/applications.json.
  Invoke-Step 'komorebi app rules' { komorebic fetch-app-specific-configuration | Out-Null } 'run: komorebic fetch-asc'
  Invoke-Step 'komorebi autostart' { komorebic enable-autostart --whkd -c (Join-Path $XdgConfig 'komorebi\komorebi.json') | Out-Null }
  # Drop the legacy logon task so it can't race the shortcut.
  Unregister-ScheduledTask -TaskName 'komorebi' -Confirm:$false -ErrorAction SilentlyContinue
}
Write-Host "[wm] Run yasb once (or add it to startup) to launch the status bar."
{{ end -}}

# --- wire the chezmoi-managed profile into the real $PROFILE for BOTH PowerShell 7
#     and Windows PowerShell 5.1. GetFolderPath('MyDocuments') is OneDrive-aware, so
#     this is correct even when Documents is redirected. Idempotent: only adds the
#     dot-source line once. ---
$Managed = Join-Path $XdgConfig 'powershell\profile.ps1'
$Docs = [Environment]::GetFolderPath('MyDocuments')
$ProfilePaths = @(
  (Join-Path $Docs 'PowerShell\Microsoft.PowerShell_profile.ps1'),        # PowerShell 7
  (Join-Path $Docs 'WindowsPowerShell\Microsoft.PowerShell_profile.ps1')  # Windows PowerShell 5.1
)
$ShimLine = ". '$Managed'"
foreach ($profilePath in $ProfilePaths) {
  New-Item -ItemType Directory -Force -Path (Split-Path $profilePath) | Out-Null
  if (-not (Test-Path $profilePath) -or
      -not (Select-String -Path $profilePath -SimpleMatch $Managed -Quiet)) {
    Add-Content -Path $profilePath -Value $ShimLine
  }
}

# Last: exit 1 if any step failed, so chezmoi re-runs this script on the next apply.
Complete-Bootstrap 'part 1'
