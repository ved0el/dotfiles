{{- $tools   := promptBoolOnce . "tools"   "Install productivity tools (ex: bat, fd, ripgrep, etc)" true -}}
{{- $develop := promptBoolOnce . "develop" "Install development tools (ex: nodejs, golang, python, etc)" false -}}
{{- $wm   := false -}}
{{- $scoopDir    := "" -}}
{{- $miseDataDir := "" -}}
{{- $tmux := false -}}
{{- $sshd := false -}}
{{- if ne .chezmoi.os "windows" -}}
{{-   $tmux = promptBoolOnce . "tmux" "Install tmux + plugins (and manage ~/.tmux.conf)" true -}}
{{- else -}}
{{-   $tmux = promptBoolOnce . "tmux" "Install psmux (tmux for Windows) + plugins (and manage ~/.tmux.conf)" true -}}
{{- /* User-scope install roots (SCOOP / MISE_DATA_DIR). Enter keeps the default; an existing
       scoop/mise root elsewhere is kept by the bootstrap regardless (they can't be moved). */ -}}
{{-   $scoopDir    = promptStringOnce . "scoopDir"    "Scoop install dir"    (printf "%s/.local/share/scoop" .chezmoi.homeDir) -}}
{{-   $miseDataDir = promptStringOnce . "miseDataDir" "mise data dir (tools)" (printf "%s/.local/share/mise" .chezmoi.homeDir) -}}
{{-   $sshd = promptBoolOnce . "sshd" "This machine is an SSH server (scoop apps over SSH: no_junction + one-time scoop reset)" false -}}
{{- end -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $wm = promptBoolOnce . "wm" "Install the macOS window manager (yabai + skhd) and its config" false -}}
{{- else if eq .chezmoi.os "windows" -}}
{{-   $wm = promptBoolOnce . "wm" "Install the Windows window manager (komorebi + whkd + yasb) and its config" false -}}
{{- end -}}
[data]
    tools   = {{ $tools }}
    develop = {{ $develop }}
    tmux    = {{ $tmux }}
    wm      = {{ $wm }}
    scoopDir    = {{ $scoopDir | toToml }}
    miseDataDir = {{ $miseDataDir | toToml }}
    sshd    = {{ $sshd }}
{{ if eq .chezmoi.os "windows" }}
# Windows: run the .ps1 bootstrap via Windows PowerShell 5.1 — ALWAYS. 5.1 lives at a fixed
# %SystemRoot%\System32\... path that never moves, so it works on a fresh box (no pwsh yet) and
# never goes stale. Do NOT bake an absolute pwsh path here: pwsh's location changes with the
# install source (scoop -> winget/Store -> versioned WindowsApps dir), and a baked path breaks
# `chezmoi apply` the moment pwsh moves. The bootstrap is written to run under 5.1.
# -ExecutionPolicy Bypass so a Restricted default policy can't block the generated script.
[interpreters.ps1]
    command = '{{ printf "%s\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" (env "SystemRoot") }}'
    args = ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass"]
# `chezmoi cd` opens pwsh instead of the default cmd.exe. Bare `pwsh` (NOT an absolute path) so
# it resolves via PATH at runtime — survives pwsh moving between install sources without re-init.
[cd]
    command = 'pwsh'
{{ end }}
