#!/bin/sh
# Bootstrap, part 1 of 2: OS packages, mise tools, zsh plugins, git wiring. Re-runs
# whenever this file's rendered content changes (e.g. you toggle a profile or add a package).
# A fresh box runs it twice: stage 1 = base packages, stage 2 = the rest (see stage1_done below).
# Claude Code + its plugins/skills are part 2 (run_onchange_after_20-install-claude), so
# declaring a plugin doesn't re-run mise install. `after_` => runs once
# all dotfiles are applied, so mise's conf.d/*.toml are in place when `mise install`
# runs.
set -eu
# run_url <url> <shell> [args]: run an installer script. Never `curl | sh`: a failed download
# feeds sh an empty script, which exits 0, so the failure is lost and the run is never retried.
run_url() { _s=$(curl --proto '=https' --tlsv1.2 -fsSL "$1") && shift && printf '%s\n' "$_s" | "$@"; }
{{- $ready := includeTemplate "bootstrap-ready" . }}

# Two stages (.chezmoitemplates/bootstrap-ready): until zsh is the login shell (+ brew on PATH on
# macOS), only the base packages install, then this prints the manual step and stops; part 2 is
# ignored meanwhile (.chezmoiignore). chsh is never run here: its password prompt hangs.
stage1_done() {
  echo
  echo "[bootstrap] Stage 1 of 2 done (base packages). To finish the install:"
{{- if ne (base (env "SHELL")) "zsh" }}
  echo "  1. chsh -s \"$(command -v zsh)\"    # zsh as your login shell"
  echo "  2. log out and back in (SSH: reconnect)"
  echo "  3. chezmoi apply"
{{- else }}
  echo "  1. open a NEW terminal (puts Homebrew on PATH)"
  echo "  2. chezmoi apply"
{{- end }}
  exit 0
}

# --- base packages: install only what's missing. btop→bottom and tree→eza are handled
#     by mise + shell aliases now, so they're no longer installed via brew/apt. ---
{{ if eq .chezmoi.os "darwin" -}}
command -v brew >/dev/null 2>&1 || /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
# A fresh Apple Silicon install isn't on this shell's PATH yet (new shells: 10-env.zsh).
if ! command -v brew >/dev/null 2>&1 && [ -x /opt/homebrew/bin/brew ]; then eval "$(/opt/homebrew/bin/brew shellenv)"; fi
# git/curl ship with macOS — only install if somehow absent.
command -v git  >/dev/null 2>&1 || brew install git
command -v curl >/dev/null 2>&1 || brew install curl
{{ if not $ready }}stage1_done{{ end }}
# mole — cleanup/optimization CLI. One project, a separate build per OS (Linux/Windows: their
# own installer below / in the .ps1), so never mise: its github:tw93/Mole picks the newest tag,
# a macOS-only release. `brew upgrade` updates it here.
command -v mole >/dev/null 2>&1 || brew install mole
# install_dmg <url> [--verify]: copy the .app(s) in a .dmg into /Applications. curl sets no
# quarantine flag, so Gatekeeper never checks it: --verify demands a notarized app (spctl).
install_dmg() {
  [ -n "$1" ] || { echo "[dmg] no .dmg url found" >&2; exit 1; }
  _tmp=$(mktemp -d)
  trap 'hdiutil detach -quiet "$_tmp/mnt" 2>/dev/null; rm -rf "$_tmp"' EXIT
  curl -fsSLo "$_tmp/app.dmg" "$1"
  hdiutil attach -quiet -nobrowse -readonly -mountpoint "$_tmp/mnt" "$_tmp/app.dmg"
  for _app in "$_tmp"/mnt/*.app; do
    [ "${2:-}" != --verify ] || spctl -a -t exec "$_app"
    cp -R "$_app" /Applications/
  done
  hdiutil detach -quiet "$_tmp/mnt"; rm -rf "$_tmp"; trap - EXIT
}
# Rex = the macOS terminal AND multiplexer (~/.config/rex/init.lua). No
# cask: the newest .dmg of its Sparkle appcast (first <enclosure>). Notarized -> --verify; self-updates.
[ -d "/Applications/Rex Beta.app" ] || [ -d /Applications/Rex.app ] || \
  install_dmg "$(curl -fsSL https://blob.superlogical.com/public/rex-app/snapshot/appcast.xml \
    | sed -n 's/.*<enclosure url="\([^"]*\.dmg\)".*/\1/p' | head -n 1)" --verify
# The font family the terminal configs name.
[ -f "$HOME/Library/Fonts/JetBrainsMonoNLNerdFont-Regular.ttf" ] || brew install --cask font-jetbrains-mono-nerd-font
{{ if .wm }}
# macOS window manager (yabai + skhd) from the upstream tap — install only what's missing
# so a re-run (cza after any fingerprint change) doesn't reinstall/upgrade them each time.
command -v yabai >/dev/null 2>&1 || brew install koekeishiya/formulae/yabai
command -v skhd  >/dev/null 2>&1 || brew install koekeishiya/formulae/skhd
skhd --start-service || true
echo "[wm] yabai installed — run 'yabai --start-service' (needs SIP setup; see the yabai wiki)"
{{ end }}
{{ if .apps -}}
# Essential GUI apps (the `apps` profile; list = .chezmoidata.yaml appList.darwin).
for _c in {{ .appList.darwin | join " " }}; do
  brew list --cask "$_c" >/dev/null 2>&1 || brew install --cask "$_c"
done
# Brave ~ Brave Origin, no telemetry: the policies in .chezmoidata.yaml bravePolicy (Windows: the
# .ps1). User-domain defaults, no sudo: Chromium on macOS reads a non-forced value as a
# RECOMMENDED policy - the default, still changeable in Settings. Mandatory would need an MDM /
# configuration profile, which macOS won't install silently. Idempotent; takes effect on relaunch.
{{ range $k, $v := .bravePolicy -}}
defaults write com.brave.Browser {{ $k }} {{ if kindIs "bool" $v }}-bool {{ $v }}{{ else }}-integer {{ $v }}{{ end }}
{{ end -}}
{{ end -}}
{{ else if eq .chezmoi.os "linux" -}}
# Batch a single apt-get for whatever is missing (skip the update entirely if nothing is).
_pkgs=""
command -v git  >/dev/null 2>&1 || _pkgs="$_pkgs git"
command -v curl >/dev/null 2>&1 || _pkgs="$_pkgs curl"
# zsh: this repo ships ~/.zshrc + the zsh/conf.d stack + sheldon, so the shell itself has to
# exist. macOS already ships zsh; Debian/Ubuntu do not.
command -v zsh  >/dev/null 2>&1 || _pkgs="$_pkgs zsh"
{{ if $ready -}}
# Colour emoji: Linux ships no colour emoji font (macOS/Windows do); fontconfig picks it up.
dpkg -s fonts-noto-color-emoji >/dev/null 2>&1 || _pkgs="$_pkgs fonts-noto-color-emoji"
{{ if .develop }}command -v make >/dev/null 2>&1 || _pkgs="$_pkgs make"{{ end }}
# Desktop font tooling: the `apps` profile — a headless server skips it.
{{ if .apps -}}
command -v xz       >/dev/null 2>&1 || _pkgs="$_pkgs xz-utils"   # Nerd Font tarball below
command -v fc-cache  >/dev/null 2>&1 || _pkgs="$_pkgs fontconfig"
{{ end -}}
{{ end -}}
if [ -n "$_pkgs" ]; then sudo apt-get update -y && sudo apt-get install -y $_pkgs; fi
{{ if not $ready }}stage1_done{{ end }}
# mole (Linux build): its official installer -> ~/.local/share/mole, linking mo/mole into
# ~/.local/bin (no sudo). After the batch above so curl exists; `mo update` updates it in place.
[ -e "$HOME/.local/bin/mo" ] || run_url https://raw.githubusercontent.com/tw93/Mole/linux/install.sh bash
{{ if .apps -}}
# The font family herdr-app names (no apt package): Nerd Fonts' release tarball, per-user.
if [ ! -f "$HOME/.local/share/fonts/JetBrainsMono/JetBrainsMonoNLNerdFont-Regular.ttf" ]; then
  mkdir -p "$HOME/.local/share/fonts/JetBrainsMono"
  curl -fsSL https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.tar.xz \
    | tar -xJ -C "$HOME/.local/share/fonts/JetBrainsMono"
  fc-cache -f "$HOME/.local/share/fonts" >/dev/null
fi
{{ end -}}
{{ if .apps -}}
# Essential GUI apps (the `apps` profile) from vendor repos, after the batch above so curl exists.
# Tailscale: its official script (picks the right repo per distro). Brave Origin (free on Linux):
# Brave's apt repo, package brave-origin.
command -v tailscale >/dev/null 2>&1 || run_url https://tailscale.com/install.sh sh
if ! dpkg -s brave-origin >/dev/null 2>&1; then
  sudo curl -fsSLo /usr/share/keyrings/brave-browser-archive-keyring.gpg https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg
  sudo curl -fsSLo /etc/apt/sources.list.d/brave-browser-release.sources https://brave-browser-apt-release.s3.brave.com/brave-browser.sources
  sudo apt-get update -y && sudo apt-get install -y brave-origin
fi
{{ end -}}
{{ end -}}
# ~/.local/bin holds self-installed tools (sheldon, mise).
export PATH="$HOME/.local/bin:$PATH"

# --- sheldon (zsh plugin manager) — idempotent; --force overwrites on upgrade ---
command -v sheldon >/dev/null 2>&1 || \
  run_url https://rossmacarthur.github.io/install/crate.sh \
    bash -s -- --force --repo rossmacarthur/sheldon --to "$HOME/.local/bin"

# --- mise (runtimes + CLI tools, cross-platform — drives the tools/develop profiles) ---
command -v mise >/dev/null 2>&1 || run_url https://mise.run sh
# The mise.run install never updates itself (Windows' scoop one does), and an old mise fails newer
# releases' attestation check (sigstore TSA cert rotation). brew/apt installs update with their PM.
if [ "$(command -v mise)" = "$HOME/.local/bin/mise" ]; then mise self-update --yes; fi

# --- install tools/runtimes declared in ~/.config/mise/conf.d/*.toml, lock sheldon ---
# --cd "$HOME": mise only auto-discovers the global conf.d/*.toml when CWD is inside the home
# tree; chezmoi may run this script from elsewhere, so anchor it at $HOME or nothing installs.
# A logged-in gh's token lifts mise's GitHub API limit (60/h unauthenticated) — same as the
# .ps1's Set-GitHubToken. gh is itself a mise tool, so this only helps on a re-run.
[ -n "${GITHUB_TOKEN:-}" ] || { GITHUB_TOKEN=$(mise --cd "$HOME" exec -- gh auth token 2>/dev/null) && export GITHUB_TOKEN; } || unset GITHUB_TOKEN
mise --cd "$HOME" install --yes

{{ if and .apps (eq .chezmoi.os "linux") -}}
# herdr-app = the terminal on a Linux client (`apps`; a server keeps just the herdr CLI; macOS
# has Rex). Official installer, per-user; self-updates, so guard on it. AFTER mise, with its
# shims on PATH: it skips its own herdr-core when one is there, so mise's stays the only copy.
# Needs a desktop session and a Vulkan driver. A warning, not a stop.
export PATH="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/shims:$PATH"
[ -e "${XDG_DATA_HOME:-$HOME/.local/share}/herdr-app/herdr-app" ] || \
  run_url https://releases.herdr.dev/app/install.sh sh || echo "[herdr-app] install failed - see above"
{{ end -}}
{{ if .tools -}}
# A vendor herdr-core from before mise managed it = a 2nd copy; not removed here (its running core
# holds every hc terminal). By hand: `hc server stop`, then delete ~/.local/bin/herdr-core and hc.
[ ! -e "$HOME/.local/bin/herdr-core" ] || \
  echo "[herdr-core] old vendor copy in ~/.local/bin (mise owns it now): remove it by hand" >&2
{{ end -}}

{{ if .tools -}}
# delta: point git at the tracked delta config via include.path (idempotent), leaving
# ~/.gitconfig's identity/signing untouched. Only when the tools profile (delta) is on.
if command -v git >/dev/null 2>&1; then
  _delta_inc="${XDG_CONFIG_HOME:-$HOME/.config}/git/delta.gitconfig"
  git config --global --get-all include.path 2>/dev/null | grep -qxF "$_delta_inc" \
    || git config --global --add include.path "$_delta_inc"
  unset _delta_inc
  # codegraph: keep each repo's .codegraph/ index out of `git status` via git's default global
  # excludes file (unmanaged — Claude Code appends to it too), idempotently.
  _gi="${XDG_CONFIG_HOME:-$HOME/.config}/git/ignore"
  grep -qxF '.codegraph/' "$_gi" 2>/dev/null || { mkdir -p "${_gi%/*}"; echo '.codegraph/' >> "$_gi"; }
  unset _gi
fi
{{ end -}}

# `lock` (not `--update`): fetch missing plugins only; updating them is the user's.
sheldon lock

