{
  "env": {
    "PONYTAIL_DEFAULT_MODE": "ultra",
    "ECC_HOOK_PROFILE": "minimal",
    "ECC_GATEGUARD": "off"
  },
  "deniedMcpServers": [
    { "serverName": "plugin:ecc:chrome-devtools" },
    { "serverName": "claude.ai Microsoft 365" }
  ],
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "PowerShell(ls:*)",
      "Bash(wc:*)",
      "PowerShell(wc:*)",
      "Bash(printf:*)",
      "PowerShell(printf:*)",
      "Bash(eza:*)",
      "PowerShell(eza:*)",
      "Bash(git status:*)",
      "PowerShell(git status:*)",
      "Bash(git diff:*)",
      "PowerShell(git diff:*)",
      "Bash(git log:*)",
      "PowerShell(git log:*)",
      "Bash(git show:*)",
      "PowerShell(git show:*)",
      "Bash(git blame:*)",
      "PowerShell(git blame:*)",
      "Bash(git ls-files:*)",
      "PowerShell(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "PowerShell(git ls-tree:*)",
      "Bash(git rev-parse:*)",
      "PowerShell(git rev-parse:*)",
      "Bash(git describe:*)",
      "PowerShell(git describe:*)",
      "Bash(git shortlog:*)",
      "PowerShell(git shortlog:*)",
      "Bash(git cat-file:*)",
      "PowerShell(git cat-file:*)",
      "Bash(git merge-base:*)",
      "PowerShell(git merge-base:*)",
      "Bash(git rev-list:*)",
      "PowerShell(git rev-list:*)",
      "Bash(git for-each-ref:*)",
      "PowerShell(git for-each-ref:*)",
      "Bash(git branch --list:*)",
      "PowerShell(git branch --list:*)",
      "Bash(git branch --show-current:*)",
      "PowerShell(git branch --show-current:*)",
      "Bash(git tag --list:*)",
      "PowerShell(git tag --list:*)",
      "Bash(git stash list:*)",
      "PowerShell(git stash list:*)",
      "Bash(git worktree list:*)",
      "PowerShell(git worktree list:*)",
      "Bash(git config --get:*)",
      "PowerShell(git config --get:*)",
      "Bash(git config --list:*)",
      "PowerShell(git config --list:*)",
      "Bash(gh status:*)",
      "PowerShell(gh status:*)",
      "Bash(gh auth status:*)",
      "PowerShell(gh auth status:*)",
      "Bash(gh repo view:*)",
      "PowerShell(gh repo view:*)",
      "Bash(gh pr view:*)",
      "PowerShell(gh pr view:*)",
      "Bash(gh pr list:*)",
      "PowerShell(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "PowerShell(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "PowerShell(gh pr checks:*)",
      "Bash(gh pr status:*)",
      "PowerShell(gh pr status:*)",
      "Bash(gh issue view:*)",
      "PowerShell(gh issue view:*)",
      "Bash(gh issue list:*)",
      "PowerShell(gh issue list:*)",
      "Bash(gh issue status:*)",
      "PowerShell(gh issue status:*)",
      "Bash(gh run list:*)",
      "PowerShell(gh run list:*)",
      "Bash(gh run view:*)",
      "PowerShell(gh run view:*)",
      "Bash(gh release list:*)",
      "PowerShell(gh release list:*)",
      "Bash(gh release view:*)",
      "PowerShell(gh release view:*)",
      "Bash(gh search:*)",
      "PowerShell(gh search:*)",
      "Bash(mise ls:*)",
      "PowerShell(mise ls:*)",
      "Bash(mise current:*)",
      "PowerShell(mise current:*)",
      "Bash(mise which:*)",
      "PowerShell(mise which:*)",
      "Bash(mise where:*)",
      "PowerShell(mise where:*)",
      "Bash(mise doctor:*)",
      "PowerShell(mise doctor:*)",
      "Bash(mise outdated:*)",
      "PowerShell(mise outdated:*)",
      "Bash(mise registry:*)",
      "PowerShell(mise registry:*)",
      "Bash(codegraph init:*)",
      "PowerShell(codegraph init:*)",
      "Bash(codegraph sync:*)",
      "PowerShell(codegraph sync:*)",
      "Bash(codegraph status:*)",
      "PowerShell(codegraph status:*)",
      "Bash(codegraph query:*)",
      "PowerShell(codegraph query:*)",
      "Bash(codegraph explore:*)",
      "PowerShell(codegraph explore:*)",
      "Bash(codegraph files:*)",
      "PowerShell(codegraph files:*)",
      "Bash(codegraph context:*)",
      "PowerShell(codegraph context:*)",
      "mcp__codegraph__*"
    ],
    "deny": [
      "Bash(rg *--pre*)",
      "PowerShell(rg *--pre*)",
      "Bash(fd -x *)",
      "PowerShell(fd -x *)",
      "Bash(fd * -x *)",
      "PowerShell(fd * -x *)",
      "Bash(fd -X *)",
      "PowerShell(fd -X *)",
      "Bash(fd * -X *)",
      "PowerShell(fd * -X *)",
      "Bash(fd *--exec*)",
      "PowerShell(fd *--exec*)",
      "Bash(bat *--pager*)",
      "PowerShell(bat *--pager*)",
      "Bash(yq -i *)",
      "PowerShell(yq -i *)",
      "Bash(yq * -i *)",
      "PowerShell(yq * -i *)",
      "Bash(yq *--inplace*)",
      "PowerShell(yq *--inplace*)",
      "Bash(git *--output*)",
      "PowerShell(git *--output*)",
      "Bash(git *--ext-diff*)",
      "PowerShell(git *--ext-diff*)",
      "Bash(git *--no-index*)",
      "PowerShell(git *--no-index*)",
      "Bash(agent-browser *--action-policy*)",
      "PowerShell(agent-browser *--action-policy*)",
      "Bash(agent-browser *--config*)",
      "PowerShell(agent-browser *--config*)",
      "Bash(*AGENT_BROWSER_ACTION_POLICY*)",
      "PowerShell(*AGENT_BROWSER_ACTION_POLICY*)",
      "Bash(*AGENT_BROWSER_CONFIG*)",
      "PowerShell(*AGENT_BROWSER_CONFIG*)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.kube/**)",
      "Edit(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Edit(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Edit(~/.netrc)",
      "Read(~/.git-credentials)",
      "Edit(~/.git-credentials)",
      "Read(~/.config/gh/hosts.yml)",
      "Edit(~/.config/gh/hosts.yml)",
      "Read(~/AppData/Roaming/GitHub CLI/**)",
      "Edit(~/AppData/Roaming/GitHub CLI/**)",
      "Read(~/.claude.json)",
      "Edit(~/.claude.json)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/.credentials.json)",
      "Read(~/.agent-browser/**)",
      "Edit(~/.agent-browser/**)",
      "Read(~/.local/share/browser-profiles/**)",
      "Edit(~/.local/share/browser-profiles/**)",
      "Read(~/AppData/Local/BraveSoftware/**)",
      "Edit(~/AppData/Local/BraveSoftware/**)",
      "Read(~/Library/Application Support/BraveSoftware/**)",
      "Edit(~/Library/Application Support/BraveSoftware/**)",
      "Read(~/.config/BraveSoftware/**)",
      "Edit(~/.config/BraveSoftware/**)",
      "Read(~/AppData/Roaming/zen/**)",
      "Edit(~/AppData/Roaming/zen/**)",
      "Read(~/Library/Application Support/zen/**)",
      "Edit(~/Library/Application Support/zen/**)",
      "Read(~/.zen/**)",
      "Edit(~/.zen/**)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env.*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "teammateMode": "in-process",
  "statusLine": {
    "type": "command",
    "command": "{{ if eq .chezmoi.os "windows" }}pwsh -NoLogo -NoProfile -File \"{{ .chezmoi.homeDir }}/.claude/statusline.ps1\"{{ else }}bash $HOME/.claude/statusline.sh{{ end }}"
  },
  "enabledPlugins": {
{{- if .develop }}
    "agentmemory@agentmemory": true,
{{- end }}
    "impeccable@impeccable": true,
    "ponytail@ponytail": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "last30days@last30days-skill": true,
    "cloudflare@cloudflare": true,
    "ecc@ecc": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      },
      "autoUpdate": true
    },
    "last30days-skill": {
      "source": {
        "source": "github",
        "repo": "mvanhorn/last30days-skill"
      },
      "autoUpdate": true
    },
{{- if .develop }}
    "agentmemory": {
      "source": {
        "source": "github",
        "repo": "rohitg00/agentmemory"
      },
      "autoUpdate": true
    },
{{- end }}
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      },
      "autoUpdate": true
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      },
      "autoUpdate": true
    },
    "ecc": {
      "source": {
        "source": "github",
        "repo": "affaan-m/ECC"
      },
      "autoUpdate": true
    }
  },
  "skillOverrides": {
    "code-review": "off",
    "diagnosing-bugs": "off",
    "domain-modeling": "off",
    "git-guardrails-claude-code": "off",
    "migrate-to-shoehorn": "off",
    "prototype": "off",
    "research": "off",
    "scaffold-exercises": "off",
    "setup-pre-commit": "off",
    "tdd": "off",
    "wizard": "off",
    "writing-for-agents": "off"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "advisorModel": "fable",
{{- if .sshd }}
  "remoteControlAtStartup": true,
{{- end }}
  "awaySummaryEnabled": false,
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "tui": "fullscreen",
  "timeFormat": "24-hour",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "autoScrollEnabled": true,
  "terminalProgressBarEnabled": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "hasCompletedOnboarding": true
}
