{{- /* chezmoi:modify-template */ -}}
{{- /* Merge the curated keys from .chezmoitemplates/windows-terminal.json into the LIVE Windows
     Terminal settings.json instead of replacing it: WT rewrites this file itself (new keys,
     UI edits). Objects merge deep with the curated value winning, lists are replaced, and keys
     only the live file has are kept. profiles.list = exactly the curated profiles, each merged
     over the live entry with the same guid so machine-local fields (icon, startingDirectory)
     survive. fromJsonc: a WT-generated file carries // comments. */ -}}
{{- $live := dict -}}
{{- if .chezmoi.stdin -}}{{- $live = fromJsonc .chezmoi.stdin -}}{{- end -}}
{{- $want := includeTemplate "windows-terminal.json" . | fromJson -}}
{{- $old := list -}}
{{- if hasKey $live "profiles" -}}{{- $old = default list (get $live.profiles "list") -}}{{- end -}}
{{- $profiles := list -}}
{{- range $p := $want.profiles.list -}}
{{-   $merged := deepCopy $p -}}
{{-   range $o := $old -}}
{{-     if eq (get $o "guid") $p.guid -}}{{- $merged = mergeOverwrite (deepCopy $o) $p -}}{{- end -}}
{{-   end -}}
{{-   $profiles = append $profiles $merged -}}
{{- end -}}
{{- $_ := set $want.profiles "list" $profiles -}}
{{- /* actions / keybindings: WT's format splits an action ({command, id}) from its key
       ({id, keys}) and rewrites an inline "keys" into that split itself — on the SSH client that
       rewrite dropped the key. So the curated entries come pre-split, and each list is the live
       one minus entries whose id or keys a curated entry claims, plus the curated entries
       (the user's own WT keys — ctrl+c, ctrl+v… — survive). */ -}}
{{- $ids := list -}}{{- $keys := list -}}{{- $cmds := list -}}
{{- range $c := concat $want.actions $want.keybindings -}}
{{-   if hasKey $c "id" -}}{{- $ids = append $ids $c.id -}}{{- end -}}
{{-   if hasKey $c "keys" -}}{{- $keys = append $keys $c.keys -}}{{- end -}}
{{-   if hasKey $c "command" -}}{{- $cmds = append $cmds (toJson $c.command) -}}{{- end -}}
{{- end -}}
{{- range $k := list "actions" "keybindings" -}}
{{-   $kept := list -}}
{{-   range $o := default list (get $live $k) -}}
{{-     $dupCmd := and (hasKey $o "command") (has (toJson (get $o "command")) $cmds) -}}
{{-     if not (or (has (get $o "id") $ids) (has (get $o "keys") $keys) $dupCmd) -}}{{- $kept = append $kept $o -}}{{- end -}}
{{-   end -}}
{{-   $_ := set $want $k (concat $kept (get $want $k)) -}}
{{- end -}}
{{ mergeOverwrite $live $want | toPrettyJson }}
