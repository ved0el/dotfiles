# =============================================================================
# Tmux Configuration - DevOps Edition
# =============================================================================
# Optimized for remote SSH s
# - Minimal, performance-focused
#
# First Time Setup:
#   1. Install TPM (Tmux Plugin Manager):
#      git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
#   2. Start tmux:        tmux
#   3. Install plugins:   C-b I (capital I)
#   4. Reload config:     C-b r
#
# Quick Start:
#   1. Start tmux:        tmux
#   2. Detach:            C-b d (or C-b C-d)
#   3. Attach:            tmux attach
#   4. List sessions:     tmux ls
#   5. Kill session:      tmux kill-session -t name
#
# Common Workflow:
#   - SSH to server:      ssh user@server
#   - Start tmux:         tmux
#   - Work in tmux:       (your commands)
#   - Detach:             C-b d (session continues running)
#   - Reconnect later:    ssh user@server && tmux attach
#   - Session auto-restores on reattach
#
# Clipboard Requirements:
#   - macOS: No additional packages needed (uses pbcopy)
#   - Linux: Install xsel or xclip (apt install xsel / yum install xsel)
#   - WSL: No additional packages needed (uses clip.exe)
#
# Windows: the same file drives psmux (scoop; `tmux` is its shim). The bootstrap
# copies the psmux-plugins (ppm instead of TPM); Windows-only differences are the
# chezmoi os-gated template blocks below. Not ported: C-b f (sessionizer).
# =============================================================================

# =============================================================================
# Core Settings
# =============================================================================
{{ if eq .chezmoi.os "windows" -}}
# No terminfo on Windows (Windows Terminal is truecolor already); SHELL is unset.
set -g default-shell pwsh
{{- else -}}
set -g default-terminal "tmux-256color"
set -g default-shell "${SHELL}"
# 24-bit truecolor passthrough — without this, neovim/modern TUI themes render
# washed-out inside tmux. Applies to any 256-colour outer terminal.
set -ga terminal-overrides ",*256col*:Tc"
{{- end }}

# Performance
set -s escape-time 0
set -g history-limit 50000
set -g status-interval 5
set -g focus-events on
set -g aggressive-resize on
{{- if ne .chezmoi.os "windows" }}
# Unknown to psmux (it warns at startup).
set -g repeat-time 1000
set -sg buffer-limit 20
{{- end }}
# Keep window numbers contiguous when one closes (pairs with base-index 1).
set -g renumber-windows on

# =============================================================================
# Prefix & Mouse
# =============================================================================
# Usage:
#   Prefix key: C-b (Ctrl+b)
#   All commands start with: C-b, then the key
#   Example: C-b c = create new window
#
# The default (tmux and psmux alike), set explicitly so a reload over a server that had
# another prefix switches back.
set -g prefix C-b
set -g mouse on

# =============================================================================
# Windows
# =============================================================================
# Usage:
#   C-b c        - Create new window
#   C-b p      - Previous window
#   C-b n      - Next window
#   C-b 0-9      - Switch to window number
#
set -g base-index 1
# Window status format defined in Status Bar section below

bind-key c new-window -c "#{pane_current_path}"
bind-key p previous-window
bind-key n next-window

# =============================================================================
# Panes
# =============================================================================
# Usage:
#   Split:
#     C-b |      - Split horizontally (left/right)
#     C-b -      - Split vertically (top/bottom)
#
#   Navigate:
#     C-b h      - Move to left pane
#     C-b j      - Move to bottom pane
#     C-b k      - Move to top pane
#     C-b l      - Move to right pane
#     C-b Tab    - Cycle to next pane
#
#   Resize (hold key to repeat):
#     C-b H      - Resize left
#     C-b J      - Resize down
#     C-b K      - Resize up
#     C-b L      - Resize right
#
#   Manage:
#     C-b q      - Kill current pane
#
#   Rename:
#     C-b ,      - Set custom pane name (persists, not overridden by shell)
#     C-b .      - Clear custom name (reverts to current command)
#
set-window-option -g pane-base-index 1

# Split
unbind '"'
unbind %
bind-key | split-window -h -c "#{pane_current_path}"
bind-key - split-window -v -c "#{pane_current_path}"

# Navigate
bind-key h select-pane -L
bind-key j select-pane -D
bind-key k select-pane -U
bind-key l select-pane -R
bind-key Tab select-pane -t :.+

# Resize
bind-key -r H resize-pane -L 10
bind-key -r J resize-pane -D 10
bind-key -r K resize-pane -U 10
bind-key -r L resize-pane -R 10

# Manage
bind-key q kill-pane

# Border
set -g pane-active-border-style fg=colour67,bg=default
set -g pane-border-style fg=colour67,bg=default
# Focused pane = the terminal background (catppuccin base), the others darker (crust).
# Both explicit: an active bg=default falls back to window-style's bg (tmux tty_default_colours).
# psmux's attached client renders these only after v3.3.8 (not in that tag's client.rs).
set -g window-style 'bg=#11111b'
set -g window-active-style 'bg=#1e1e2e'
set -g pane-border-status bottom
{{ if eq .chezmoi.os "windows" -}}
# psmux: no pane-scoped user options (`set -p @x` errors), and the border label is a
# plain string replace of #{pane_title} / #{pane_index} / #P (src/client.rs) — anything
# else (#T, #{?…}, #{b:…}) prints literally, and #P is the pane id (%13 → 13). So the
# name is the pane title: allow-set-title lets programs set it (pwsh → pane<id> via the
# profile, claude → its own), `select-pane -T` locks a custom one.
#   C-b ,    - Set (lock) pane name. No reset key: `select-pane -T ''` loses the '' in a bind.
set -g allow-set-title on
set -g pane-border-format " #{pane_title} "
bind-key , command-prompt -p "Rename pane:" "select-pane -T '%%'"
{{- else -}}
# Show custom name if set, otherwise fall back to current command
set -g pane-border-format " #P: #{?#{@pane_name},#[bold]#{@pane_name}#[nobold],#{pane_current_command}} PID:#{pane_pid} "

# Rename pane (name persists, immune to terminal escape sequences)
#   C-b ,    - Set custom pane name
#   C-b .    - Clear custom name (reverts to current command)
bind-key , command-prompt -p "Rename pane:" "set-option -p @pane_name '%%'"
bind-key . set-option -p -u @pane_name
{{- end }}


# =============================================================================
# Sessions
# =============================================================================
# Usage:
#   C-b s        - Choose/switch session (interactive)
#   C-b S        - Manually save session state
#   C-b R        - Manually restore session state
#   tmux new -s name    - Create new session from command line
#   tmux attach -t name - Attach to existing session
#   tmux ls             - List all sessions
#
# Note: Sessions auto-save every 5 minutes and auto-restore on tmux start
#
bind-key s choose-session
{{ if eq .chezmoi.os "windows" -}}
# psmux-resurrect's own scripts (its plugin.conf also binds C-s / C-r).
bind-key S run-shell 'pwsh -NoProfile -ExecutionPolicy Bypass -File "~/.psmux/plugins/psmux-resurrect/scripts/save.ps1"'
bind-key R run-shell 'pwsh -NoProfile -ExecutionPolicy Bypass -File "~/.psmux/plugins/psmux-resurrect/scripts/restore.ps1"'
{{- else -}}
bind-key S run-shell '~/.tmux/plugins/tmux-resurrect/scripts/save.sh'
bind-key R run-shell '~/.tmux/plugins/tmux-resurrect/scripts/restore.sh'

# Fuzzy project/session jumper (fzf + zoxide) — the "tmux-sessionizer".
#   C-b f  - floating picker over your zoxide frecent dirs + open sessions; jumps
#            to the pick, creating the session on the fly. (Replaces find-window;
#            use C-b s for the classic session list.) Falls back to a message if
#            fzf is absent. Script: ~/.local/bin/tmux-sessionizer.
bind-key f display-popup -E -w 75% -h 70% "tmux-sessionizer"
{{- end }}

# =============================================================================
# Copy Mode
# =============================================================================
# Usage:
#   C-b [        - Enter copy mode (default)
#   C-b y        - Enter copy mode (custom)
#   In copy mode:
#     v          - Start selection (vi-style)
#     y          - Copy selection to clipboard (tmux-yank handles this)
#     Esc        - Exit copy mode
#
#   Mouse:       - Drag to select, release to copy
#
# Note: tmux-yank plugin auto-detects clipboard tool
#       (macOS: pbcopy/reattach, Linux: xsel/xclip/wl-copy, WSL: clip.exe)
#       Custom keybinding (prefix+y) is set after plugin initialization below
#
set-window-option -g mode-keys vi

# Vi-style visual selection
bind-key -T copy-mode-vi v send-keys -X begin-selection

# =============================================================================
# Status Bar
# =============================================================================
# Format:
#   Left:  User@Host | Window
#   Right: Window list (1 2 3 4, current highlighted, right-aligned)
#
set -g status-position bottom
set -g status-justify right
set -g status-interval 1
set -g status-left-length 150
set -g status-right-length 0
set -g status-style bg=default,fg=colour240

# Left side: User@Host | Window
# Using tmux-cpu plugin for CPU and RAM display
# User: live foreground user of the active pane (tracks sudo -i / su -), not the
# tmux server's login — see ~/.local/bin/tmux-user. status-interval (1s) refreshes it.
{{ if eq .chezmoi.os "windows" -}}
# Windows: no tty to inspect — the login user, baked in at apply time.
set -g status-left ' #[fg=grey]User: {{ .chezmoi.username | splitList "\\" | last }}@#h#[fg=default] | Window: #W #{?client_prefix,#[fg=white]#[bg=blue] Wait #[bg=default],}#[fg=default] '
{{- else -}}
set -g status-left ' #[fg=grey]User: #(~/.local/bin/tmux-user "#{pane_tty}")@#h#[fg=default] | Window: #W #{prefix_highlight}#[fg=default] '
{{- end }}

# Right side: Window list | CPU | RAM | Time (right-aligned)
set -g status-right '#{cpu_fg_color} CPU: #{cpu_percentage}#[fg=default] | #{ram_fg_color}RAM: #{ram_percentage}#[fg=default] | #[fg=grey] %H:%M #[fg=yellow] '

# Window status format (simple numbers: 1 2 3 4)
set -g window-status-format ' #[fg=grey]#I '
set -g window-status-current-format ' #[fg=yellow,bold]#I '

# Window status separator
set -g window-status-separator '#[fg=default]|'

# Window status styles (original highlight: yellow)
set-window-option -g window-status-style fg=grey,bg=default,dim
set-window-option -g window-status-current-style fg=yellow,bg=default,bright
set-window-option -g window-status-activity-style fg=colour223,bg=default

# Messages
set -g message-style bg=default,fg=grey
set -g message-command-style bg=default,fg=grey

# =============================================================================
# Configuration
# =============================================================================
# Usage:
#   C-b r        - Reload tmux configuration (apply changes without restart)
#
{{ if eq .chezmoi.os "windows" -}}
# psmux: an absolute path (`~/.tmux.conf\;` from a key binding reported the file missing).
bind-key r source-file "{{ .chezmoi.homeDir }}/.tmux.conf" \; display-message "Config reloaded"
{{- else -}}
bind-key r source-file ~/.tmux.conf\; display-message "Config reloaded"
{{- end }}

# =============================================================================
# Plugins
# =============================================================================
# Options first: psmux sources each plugin's plugin.conf at its @plugin line.
# tmux-resurrect & continuum
set -g @resurrect-capture-pane-contents 'on'
set -g @continuum-save-interval '5'
set -g @continuum-restore 'on'
set -g @continuum-boot 'off'

{{ if eq .chezmoi.os "windows" -}}
# psmux-plugins, copied into ~/.psmux/plugins by the bootstrap (keep its list in sync).
# No yank plugin: psmux writes the Windows clipboard natively. No psmux-sensible: it uses
# plain `set -g` + binds (escape-time 50, `R` → ~/.psmux.conf, `|`/`-` without the cwd),
# overriding this file — everything else it sets is already set above. No psmux-cpu: its
# status-interval hook spawns pwsh every tick (an error flashes each time) for stats the
# status bar doesn't show.
set -g @plugin 'psmux-plugins/ppm'
set -g @plugin 'psmux-plugins/psmux-resurrect'
set -g @plugin 'psmux-plugins/psmux-continuum'
set -g @plugin 'psmux-plugins/psmux-prefix-highlight'

# =============================================================================
# Initialize
# =============================================================================
run '~/.psmux/plugins/ppm/ppm.ps1'
{{- else -}}
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'tmux-plugins/tmux-cpu'
set -g @plugin 'tmux-plugins/tmux-prefix-highlight'

# Plugin Config
# tmux-yank: clipboard selection and mouse support
set -g @yank_selection 'clipboard'
set -g @yank_selection_mouse 'clipboard'
# Stay in copy mode after yanking (allows visual confirmation of selection)
set -g @yank_action 'copy-pipe'
# Disable auto-copy on mouse drag release — press y to copy after selecting
set -g @yank_with_mouse 'off'
set -g @resurrect-save-bash-history 'on'

# =============================================================================
# Initialize
# =============================================================================
run '~/.tmux/plugins/tpm/tpm'
{{- end }}

# =============================================================================
# Custom Key Bindings (After Plugin Load)
# =============================================================================
# Override tmux-yank's default prefix+y behavior
# By default, tmux-yank binds prefix+y to copy command line
# We override it to enter copy mode instead for text selection
bind-key y copy-mode
{{- if eq .chezmoi.os "windows" }}

# psmux has no extended-keys, so C-Enter reaches the pane as a bare Enter (Claude Code then
# submits instead of adding a line). Send C-j, a newline in Claude Code's input.
bind-key -n C-Enter send-keys C-j
{{- end }}
