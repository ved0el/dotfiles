{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.35/schema.json",
  "app_specific_configuration_path": "$Env:KOMOREBI_CONFIG_HOME/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 4,
  "default_container_padding": 4,
  "border": true,
  "border_width": 2,
  "border_offset": 0,
  "border_style": "System",
  "border_colours": {
    "single": "#42a5f5",
    "stack": "#00a542",
    "monocle": "#ff3399",
    "unfocused": "#808080"
  },
  "stackbar": {
    "height": 40,
    "mode": "OnStack",
    "tabs": {
      "width": 300
    }
  },
  "display_index_preferences": {
    "0": "408NTWG6A521",
    "1": "606BNGU0B591"
  },
  "monitors": [
    {
      "workspaces": [
        {
          "name": "I",
          "layout": "BSP"
        },
        {
          "name": "II",
          "layout": "BSP"
        }
      ]
    },
    {
      "workspaces": [
        {
          "name": "1",
          "layout": "Columns"
        }
      ]
    }
  ],
  "manage_rules": [
    {
      "kind": "Exe",
      "id": "Zalo.exe",
      "matching_strategy": "Equals"
    }
  ],
  "object_name_change_applications": [
    {
      "kind": "Exe",
      "id": "brave.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "Revit.exe",
      "matching_strategy": "Equals"
    }
  ],
  "floating_applications": [
    {
      "kind": "Title",
      "id": "Picture",
      "matching_strategy": "StartsWith"
    },
    {
      "kind": "Title",
      "id": "VPN",
      "matching_strategy": "Contains"
    },
    {
      "kind": "Title",
      "id": "Desktop Media Player",
      "matching_strategy": "Contains"
    },
    {
      "kind": "Title",
      "id": "_crx_",
      "matching_strategy": "StartsWith"
    },
    [
      {
        "kind": "Exe",
        "id": "Revit.exe",
        "matching_strategy": "Equals"
      },
      {
        "kind": "Title",
        "id": "Autodesk Revit",
        "matching_strategy": "DoesNotStartWith"
      }
    ]
  ],
  "ignore_rules": [
    {
      "kind": "Title",
      "id": "Counter-Strike 2",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "bash.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "cmd.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "powershell.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "git-bash.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "pwsh.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Class",
      "id": "Tauri Window",
      "matching_strategy": "Contains"
    },
    {
      "kind": "Exe",
      "id": "Palworld-Win64-Shipping.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "DeltaForceClient-Win64-Shipping.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "DeltaForceClient.exe",
      "matching_strategy": "Equals"
    }
  ]
}
