{{- /* chezmoi:modify-template */ -}}
{{- /* Defaults only: fill a key the LIVE settings.json lacks, never touch one it has, so each
     box picks its own font/theme in the app and chezmoi never reverts it or shows a diff.
     The app writes zoom, sounds, appearance here itself. A theme picked in the app's menu is
     stored per layout (layouts/.state/<layout>.json) and wins anyway. Themes: ./themes.
     telemetry: off (releases send a daily usage report when the key is absent). */ -}}
{{- $live := dict -}}
{{- if .chezmoi.stdin -}}{{- $live = fromJson .chezmoi.stdin -}}{{- end -}}
{{- $defaults := dict
      "font" "JetBrainsMonoNL Nerd Font"
      "ui_font" "JetBrainsMonoNL Nerd Font"
      "font_size" 16
      "font_ligatures" false
      "telemetry" false
      "theme" (dict "light" "paper" "dark" "nord") -}}
{{- range $k, $v := $defaults -}}
{{-   if not (hasKey $live $k) -}}{{- $_ := set $live $k $v -}}{{- end -}}
{{- end -}}
{{- toPrettyJson $live -}}
