# repo files — never apply these to $HOME
README.md
AGENTS.md
**/AGENTS.md
!.ssh/AGENTS.md
renovate.json
install.ps1

# Machine-local mise config — `mise use -g` writes here by default (no env var; never
# set MISE_GLOBAL_CONFIG_FILE, it breaks conf.d discovery outside $HOME).
# Never managed by chezmoi, so per-machine tool pins stay untracked + survive apply.
.config/mise/config.toml

# Bootstrap scripts (10-install-packages, 20-install-claude): ship exactly one set per
# platform family. The other would fail to execute (a .sh can't run on Windows; a .ps1 is
# meaningless on Unix).
{{ if eq .chezmoi.os "windows" }}
*-install-*.sh
{{ else }}
*-install-*.ps1
15-git-bash-path.ps1
{{ end }}
# Stage 1 of a fresh install (.chezmoitemplates/bootstrap-ready): part 1 installs only the base,
# so part 2 (Claude, plugins) waits for the manual step + the next apply.
{{ if not (includeTemplate "bootstrap-ready" .) }}
*-install-claude.*
{{ end }}

# OS split for shell config. Windows uses the PowerShell profile; Unix uses the zsh
# stack (zsh/sheldon/p10k). Each side ignores the other's files.
{{ if eq .chezmoi.os "windows" }}
.zshrc
.zshenv
.p10k.zsh
.config/zsh
.config/sheldon
.local/bin/bp
.claude/statusline.sh
{{ else }}
.config/powershell
.config/mise/conf.d/windows.toml
.config/starship.toml
.claude/statusline.ps1
{{ end }}

# herdr-app only on clients (`apps`) off macOS (Rex there); a server keeps just the herdr CLI.
{{ if or (eq .chezmoi.os "darwin") (not .apps) }}
.config/herdr-app
{{ end }}
# Rex (terminal + multiplexer) is a macOS-only app.
{{ if ne .chezmoi.os "darwin" }}
.config/rex
{{ end }}
{{ if or (ne .chezmoi.os "darwin") (not .wm) }}
.config/skhd
.config/yabai
{{ end }}
{{ if or (ne .chezmoi.os "windows") (not .wm) }}
.config/whkd
.config/komorebi
.config/yasb
{{ end }}
{{ if not .tools }}
.config/bat
.config/fd
.config/git
.config/micro
.config/ripgrep
.config/zsh/conf.d/75-tools.zsh
.config/mise/conf.d/tools.toml
.agent-browser
.local/bin/bp
{{ end }}
{{ if not .develop }}
.config/mise/conf.d/develop.toml
{{ end }}
