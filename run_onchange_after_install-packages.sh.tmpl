#!/bin/sh
# Bootstrap packages + plugins. Re-runs automatically whenever this file's rendered
# content changes (e.g. you toggle a profile or add a package). `after_` => runs once
# all dotfiles are applied, so mise's conf.d/*.toml are in place when `mise install`
# runs.
set -eu

# --- base packages: install only what's missing. btop→bottom and tree→eza are handled
#     by mise + shell aliases now, so they're no longer installed via brew/apt. ---
{{ if eq .chezmoi.os "darwin" -}}
command -v brew >/dev/null 2>&1 || /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
# git/curl ship with macOS — only install if somehow absent.
command -v git  >/dev/null 2>&1 || brew install git
command -v curl >/dev/null 2>&1 || brew install curl
{{ if .tmux }}command -v tmux >/dev/null 2>&1 || brew install tmux{{ end }}
# mole — macOS cleanup/optimization CLI (macOS only).
command -v mole >/dev/null 2>&1 || brew install mole
{{ if .wm }}
# macOS window manager (yabai + skhd) from the upstream tap — install only what's missing
# so a re-run (cza after any fingerprint change) doesn't reinstall/upgrade them each time.
command -v yabai >/dev/null 2>&1 || brew install koekeishiya/formulae/yabai
command -v skhd  >/dev/null 2>&1 || brew install koekeishiya/formulae/skhd
skhd --start-service || true
echo "[wm] yabai installed — run 'yabai --start-service' (needs SIP setup; see the yabai wiki)"
{{ end }}
{{ else if eq .chezmoi.os "linux" -}}
# Batch a single apt-get for whatever is missing (skip the update entirely if nothing is).
_pkgs=""
command -v git  >/dev/null 2>&1 || _pkgs="$_pkgs git"
command -v curl >/dev/null 2>&1 || _pkgs="$_pkgs curl"
# zsh: this repo ships ~/.zshrc + the zsh/conf.d stack + sheldon, so the shell itself has to
# exist. macOS already ships zsh; Debian/Ubuntu do not.
command -v zsh  >/dev/null 2>&1 || _pkgs="$_pkgs zsh"
{{ if .tmux }}command -v tmux >/dev/null 2>&1 || _pkgs="$_pkgs tmux"{{ end }}
if [ -n "$_pkgs" ]; then sudo apt-get update -y && sudo apt-get install -y $_pkgs; fi
{{ end -}}

# chsh is interactive (it prompts for a password), so it is NOT run here — just say so once.
# SHELL can be unset in a non-interactive run, and `set -u` makes ${SHELL##*/} fatal, so default it.
_login_sh="${SHELL:-}"
if command -v zsh >/dev/null 2>&1 && [ "${_login_sh##*/}" != "zsh" ]; then
  echo "[shell] login shell is ${_login_sh:-unset} — run: chsh -s \"$(command -v zsh)\"  (then re-login)"
fi
unset _login_sh

# ~/.local/bin holds self-installed tools (sheldon, mise).
export PATH="$HOME/.local/bin:$PATH"

# --- sheldon (zsh plugin manager) — idempotent; --force overwrites on upgrade ---
command -v sheldon >/dev/null 2>&1 || \
  curl --proto '=https' -fLsS https://rossmacarthur.github.io/install/crate.sh | \
    bash -s -- --force --repo rossmacarthur/sheldon --to "$HOME/.local/bin"

# --- mise (runtimes + CLI tools, cross-platform — drives the tools/develop profiles) ---
command -v mise >/dev/null 2>&1 || \
  curl --proto '=https' --tlsv1.2 -fsSL https://mise.run | sh

{{ if .tmux -}}
# --- tmux plugins (TPM) — server-free install --------------------------------
# A TPM "install" is just `git clone` into ~/.tmux/plugins/<name>, so we clone the
# plugins directly instead of driving tmux. We deliberately DON'T use TPM's own
# bin/install_plugins: it needs a live tmux server that has sourced the config (to
# read TMUX_PLUGIN_MANAGER_PATH), and during a non-interactive bootstrap that path
# was the source of two bugs —
#   1. a session-less `tmux start-server` exits before TPM can query it, so TPM
#      aborted with "not configured" and installed ZERO plugins (silently, because
#      stderr was sent to /dev/null); and
#   2. starting a server on the default socket left a stale server behind, which
#      then made plain `tmux` abort with "server exited unexpectedly" after the
#      next tmux upgrade (old server vs newly-installed client).
# Cloning needs no server, touches no socket, never hides errors, and is safe to
# re-run. TPM still manages updates at runtime via `prefix + I` / `prefix + U`.
tpm_dir="$HOME/.tmux/plugins"
mkdir -p "$tpm_dir"
[ -d "$tpm_dir/tpm" ] || \
  git clone --depth 1 https://github.com/tmux-plugins/tpm "$tpm_dir/tpm"
# Clone every `set -g @plugin 'owner/repo'` (or full git URL) declared in the config
# that isn't present yet. A failed clone warns but never aborts the bootstrap.
sed -n "s/^[[:space:]]*set[^@]*@plugin[[:space:]]*['\"]\([^'\"]*\)['\"].*/\1/p" \
      "$HOME/.tmux.conf" 2>/dev/null \
  | while IFS= read -r plugin; do
      [ -n "$plugin" ] || continue
      name=${plugin##*/}; name=${name%.git}
      if [ -d "$tpm_dir/$name" ]; then continue; fi
      case "$plugin" in
        *://*) url="$plugin" ;;
        *)     url="https://github.com/$plugin" ;;
      esac
      echo "[tmux] installing plugin: $name"
      git clone --depth 1 "$url" "$tpm_dir/$name" \
        || echo "[tmux] WARN: clone failed for $plugin — run 'prefix + I' in tmux to retry"
    done
{{ end -}}

# --- install tools/runtimes declared in ~/.config/mise/conf.d/*.toml, lock sheldon ---
# --cd "$HOME": mise only auto-discovers the global conf.d/*.toml when CWD is inside the home
# tree; chezmoi may run this script from elsewhere, so anchor it at $HOME or nothing installs.
mise --cd "$HOME" install --yes

# rtk (rtk-ai/rtk) — install its Claude Code command-rewrite hook globally. --auto-patch
# edits ~/.claude/settings.json without prompting, keeping this bootstrap non-interactive;
# it's idempotent so re-runs are safe, and `|| true` keeps a hiccup from aborting setup.
command -v rtk >/dev/null 2>&1 && rtk init -g --auto-patch || \
  mise --cd "$HOME" exec -- rtk init -g --auto-patch || true

# Claude Code itself — the marketplace step below is a no-op without it, and since the
# run_onchange fingerprint wouldn't change afterwards it would never retry on a fresh box.
# Official installer; lands in ~/.local/bin (already on PATH above) and self-updates after that.
command -v claude >/dev/null 2>&1 || \
  curl -fsSL https://claude.ai/install.sh | bash || \
  echo "[claude] install failed — install Claude Code by hand"

# Claude Code marketplaces + plugins — INSTALL ONLY WHAT'S MISSING. The ids below are
# rendered straight out of dot_claude/settings.json.tmpl, so that file stays the single
# source of truth and the rendered list doubles as this script's run_onchange fingerprint:
# declaring a new marketplace/plugin re-fires the script, unrelated settings churn doesn't.
# `plugin list`/`marketplace list` are local reads, so a box that already has everything
# does no network work. Refreshing what IS installed is `chezmoi update`'s job — see
# run_after_update-claude-plugins.sh. grep -F over the --json dump keeps this jq-free.
{{- $settings := includeTemplate "dot_claude/settings.json.tmpl" . | fromJson }}
if command -v claude >/dev/null 2>&1; then
  have_mk=$(claude plugin marketplace list --json 2>/dev/null || true)
{{- range $name, $mk := $settings.extraKnownMarketplaces }}
  printf '%s' "$have_mk" | grep -qF '"name": "{{ $name }}"' || \
    claude plugin marketplace add '{{ index $mk.source "repo" | default (index $mk.source "url") }}' || \
    echo "[claude] marketplace add {{ $name }} failed"
{{- end }}
  # -y is mandatory: the install prompt has no TTY here and would otherwise hang.
  have_plugin=$(claude plugin list --json 2>/dev/null || true)
{{- range $id, $_ := $settings.enabledPlugins }}
  printf '%s' "$have_plugin" | grep -qF '"{{ $id }}"' || \
    claude plugin install -y '{{ $id }}' || echo "[claude] install {{ $id }} failed"
{{- end }}
fi

# Agent skills from repos with no plugin marketplace — `skills` CLI, the official method in their
# READMEs. Declared as `repo:skillspec:anchor`:
#   skillspec — the `--skill` value. A name (repo basename is NOT always it: vercel-labs/skills
#               ships `find-skills`), or `*` for "every skill this repo ships", which keeps up
#               with upstream on its own (mattpocock/skills went 38 -> 37 names in three days,
#               taste-skill 10 -> 13; a pinned name list would rot and fail on removed names).
#   anchor    — the skill dir whose presence means "this repo is already done here". Exact for a
#               single-skill entry; a representative one for a `*` entry, since knowing the full
#               set of a `*` repo needs the network we are trying to avoid. Delete
#               ~/.claude/skills/<anchor> to force a reinstall.
# INSTALL ONLY WHAT'S MISSING — the CLI lands skills in ~/.claude/skills/<name>, which chezmoi
# does NOT manage, so `apply` never fights them and that dir is the check. Refreshing is
# `chezmoi update`'s job, see run_after_update-claude-plugins.sh. Every flag is load-bearing for
# a non-interactive run: `npx -y` skips npx's own "install skills?" prompt on a cold cache, the
# trailing `-y` skips the CLI's confirmation, `--agent claude-code` stops it asking which agent
# (WITHOUT it the skill installs for codex/gemini/copilot only and Claude never sees it),
# `--skill` pins the selection, and `--copy` avoids symlinks (Windows symlinks need elevation,
# which this bootstrap never takes). npx comes from mise's node ("develop" profile), so try PATH,
# then mise, then warn — a tools-only box simply goes without.
for _entry in blader/humanizer:humanizer:humanizer tt-a1i/archify:archify:archify \
              vercel-labs/skills:find-skills:find-skills 'mattpocock/skills:*:ask-matt' \
              'Leonxlnx/taste-skill:*:brandkit'; do
  _repo="${_entry%%:*}"; _rest="${_entry#*:}"; _spec="${_rest%:*}"; _anchor="${_rest##*:}"
  if [ -e "$HOME/.claude/skills/$_anchor" ]; then continue; fi
  command -v npx >/dev/null 2>&1 && \
    npx -y skills add "$_repo" --skill "$_spec" --agent claude-code -g -y --copy || \
    mise --cd "$HOME" exec -- npx -y skills add "$_repo" --skill "$_spec" --agent claude-code -g -y --copy || \
    echo "[skills] $_repo skipped — needs node/npx (the develop profile)"
done
unset _entry _repo _rest _spec _anchor

{{ if .tools -}}
# delta: point git at the tracked delta config via include.path (idempotent), leaving
# ~/.gitconfig's identity/signing untouched. Only when the tools profile (delta) is on.
if command -v git >/dev/null 2>&1; then
  _delta_inc="${XDG_CONFIG_HOME:-$HOME/.config}/git/delta.gitconfig"
  git config --global --get-all include.path 2>/dev/null | grep -qxF "$_delta_inc" \
    || git config --global --add include.path "$_delta_inc"
  unset _delta_inc
fi
{{ end -}}

sheldon lock --update
