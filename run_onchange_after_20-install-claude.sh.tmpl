#!/bin/sh
# Bootstrap, part 2 of 2: Claude Code, its marketplaces/plugins/skills, rtk's hook and the
# codegraph MCP server. Runs after part 1 (alphabetical), so mise + its tools exist. Its own
# fingerprint: declaring a plugin or skill re-runs only this, not the package install.
set -eu
# Separate process from part 1: ~/.local/bin (mise, claude) has to go on PATH again.
export PATH="$HOME/.local/bin:$PATH"
# A failed step must fail the script: chezmoi never re-runs a run_onchange script that exited 0,
# so a swallowed failure would leave that piece missing for good. Steps stay idempotent, so the
# retry (next `apply`) only redoes what's missing — same contract as the .ps1's Invoke-Step.
failed=0
fail() { echo "$1" >&2; failed=1; }

# rtk (rtk-ai/rtk) — install its Claude Code command-rewrite hook globally. --auto-patch
# edits ~/.claude/settings.json without prompting, keeping this bootstrap non-interactive;
# it's idempotent so re-runs are safe. rtk is a `tools` mise tool.
{{ if .tools -}}
{ command -v rtk >/dev/null 2>&1 && rtk init -g --auto-patch; } || \
  mise --cd "$HOME" exec -- rtk init -g --auto-patch || fail "[rtk] hook install failed"
{{ end -}}

# Claude Code itself — the marketplace step below is a no-op without it, and since the
# run_onchange fingerprint wouldn't change afterwards it would never retry on a fresh box.
# Official installer; lands in ~/.local/bin (already on PATH above) and self-updates after that.
# Download first: `curl | bash` would turn a failed download into an empty script that exits 0.
command -v claude >/dev/null 2>&1 || \
  { _s=$(curl -fsSL https://claude.ai/install.sh) && printf '%s\n' "$_s" | bash; } || \
  fail "[claude] install failed"

# Claude Code marketplaces + plugins — INSTALL ONLY WHAT'S MISSING. The ids below are
# rendered straight out of .chezmoitemplates/claude-settings.json, so that file stays the single
# source of truth and the rendered list doubles as this script's run_onchange fingerprint:
# declaring a new marketplace/plugin re-fires the script, unrelated settings churn doesn't.
# `plugin list`/`marketplace list` are local reads, so a box that already has everything
# does no network work. Updating what IS installed is the user's, inside Claude (marketplaces
# auto-update; dot_claude/AGENTS.md). grep -F over the --json dump keeps this jq-free.
{{- $settings := includeTemplate "claude-settings.json" . | fromJson }}
if command -v claude >/dev/null 2>&1; then
  have_mk=$(claude plugin marketplace list --json 2>/dev/null || true)
{{- range $name, $mk := $settings.extraKnownMarketplaces }}
  printf '%s' "$have_mk" | grep -qF '"name": "{{ $name }}"' || \
    claude plugin marketplace add '{{ index $mk.source "repo" | default (index $mk.source "url") }}' || \
    fail "[claude] marketplace add {{ $name }} failed"
{{- end }}
  # -y is mandatory: the install prompt has no TTY here and would otherwise hang.
  have_plugin=$(claude plugin list --json 2>/dev/null || true)
{{- range $id, $_ := $settings.enabledPlugins }}
  printf '%s' "$have_plugin" | grep -qF '"{{ $id }}"' || \
    claude plugin install -y '{{ $id }}' || fail "[claude] install {{ $id }} failed"
{{- end }}
  # claude-mem was replaced by agentmemory: uninstall it + its marketplace (~/.claude-mem data stays).
  # ponytail: one-shot cleanup; delete this block once every box has applied it.
  if printf '%s' "$have_plugin" | grep -qF '"claude-mem@thedotmack"'; then
    { claude plugin uninstall claude-mem@thedotmack && claude plugin marketplace remove thedotmack; } || \
      fail "[claude] claude-mem removal failed"
  fi
fi

# Agent skills from repos with no plugin marketplace — `skills` CLI, the official method in their
# READMEs. Declared as `repo:skillspec:anchor`:
#   skillspec — the `--skill` value. A name (repo basename is NOT always it: vercel-labs/skills
#               ships `find-skills`), or `*` for "every skill this repo ships", which keeps up
#               with upstream on its own (mattpocock/skills went 38 -> 37 names in three days,
#               taste-skill 10 -> 13; a pinned name list would rot and fail on removed names).
#   anchor    — the skill dir whose presence means "this repo is already done here". Exact for a
#               single-skill entry; a representative one for a `*` entry, since knowing the full
#               set of a `*` repo needs the network we are trying to avoid. Delete
#               ~/.claude/skills/<anchor> to force a reinstall.
# INSTALL ONLY WHAT'S MISSING — the CLI lands skills in ~/.claude/skills/<name>, which chezmoi
# does NOT manage, so `apply` never fights them and that dir is the check. Updating them is the
# user's (`npx -y skills update -g -y`). Every flag is load-bearing for
# a non-interactive run: `npx -y` skips npx's own "install skills?" prompt on a cold cache, the
# trailing `-y` skips the CLI's confirmation, `--agent claude-code` stops it asking which agent
# (WITHOUT it the skill installs for codex/gemini/copilot only and Claude never sees it),
# `--skill` pins the selection, and `--copy` avoids symlinks (Windows symlinks need elevation,
# which this bootstrap never takes). npx comes from mise's node, so skills belong to the
# `develop` profile; try PATH, then mise, then warn.
{{ if .develop -}}
for _entry in tt-a1i/archify:archify:archify 'mattpocock/skills:*:ask-matt'; do
  _repo="${_entry%%:*}"; _rest="${_entry#*:}"; _spec="${_rest%:*}"; _anchor="${_rest##*:}"
  if [ -e "$HOME/.claude/skills/$_anchor" ]; then continue; fi
  { command -v npx >/dev/null 2>&1 && \
    npx -y skills add "$_repo" --skill "$_spec" --agent claude-code -g -y --copy; } || \
    mise --cd "$HOME" exec -- npx -y skills add "$_repo" --skill "$_spec" --agent claude-code -g -y --copy || \
    fail "[skills] $_repo failed (needs node/npx from the develop profile)"
done
unset _entry _repo _rest _spec _anchor

# Retired skill repos (humanizer, find-skills, Leonxlnx/taste-skill): every skill they shipped
# was switched off in skillOverrides, so they're gone. `skills remove` (not rm -rf) also drops
# them from the CLI's lock, or a later `skills update` would bring them back. Anchor-guarded.
# ponytail: one-shot cleanup; delete this block once every box has applied it.
if [ -e "$HOME/.claude/skills/brandkit" ] || [ -e "$HOME/.claude/skills/humanizer" ]; then
  mise --cd "$HOME" exec -- npx -y skills remove -g -y humanizer find-skills brandkit \
    design-taste-frontend design-taste-frontend-v1 full-output-enforcement gpt-taste \
    high-end-visual-design image-to-code imagegen-frontend-mobile imagegen-frontend-web \
    industrial-brutalist-ui minimalist-ui redesign-existing-projects stitch-design-taste \
    || fail "[skills] retired-skill cleanup failed"
fi

# agentmemory's server (the agentmemory plugin's hooks + MCP talk to it; mise tool in develop.toml)
# at login: a systemd user unit (Linux) / LaunchAgent (macOS). It detaches its engine and exits,
# so oneshot + RemainAfterExit / AbandonProcessGroup keep the engine alive; CI=1 keeps a first
# run's onboarding non-interactive. mise's absolute path: neither gets shell activation.
# Rewritten + (re)loaded only when the unit's content changes; loading also starts it now.
# --port: this account's own port (.chezmoitemplates/agentmemory-port), so users don't collide.
_mise=$(command -v mise || true)
{{- if eq .chezmoi.os "darwin" }}
_unit="$HOME/Library/LaunchAgents/local.agentmemory.plist"
_want=$(cat <<UNIT
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>local.agentmemory</string>
  <key>ProgramArguments</key><array>
    <string>$_mise</string><string>--cd</string><string>$HOME</string><string>exec</string><string>--</string><string>agentmemory</string><string>--port</string><string>{{ includeTemplate "agentmemory-port" . }}</string>
  </array>
  <key>EnvironmentVariables</key><dict><key>CI</key><string>1</string></dict>
  <key>WorkingDirectory</key><string>$HOME</string>
  <key>RunAtLoad</key><true/>
  <key>AbandonProcessGroup</key><true/>
</dict></plist>
UNIT
)
if [ -z "$_mise" ]; then
  fail "[agentmemory] mise not found"
elif [ "$(cat "$_unit" 2>/dev/null)" != "$_want" ]; then
  { mkdir -p "${_unit%/*}" && printf '%s\n' "$_want" > "$_unit" && \
    { launchctl bootout "gui/$(id -u)/local.agentmemory" 2>/dev/null || true; } && \
    { "$_mise" --cd "$HOME" exec -- agentmemory stop >/dev/null 2>&1 || true; } && \
    launchctl bootstrap "gui/$(id -u)" "$_unit"; } || fail "[agentmemory] LaunchAgent failed"
fi
{{- else }}
_unit="$HOME/.config/systemd/user/agentmemory.service"
_want=$(cat <<UNIT
[Unit]
Description=agentmemory memory server

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h
Environment=CI=1
ExecStart=$_mise --cd %h exec -- agentmemory --port {{ includeTemplate "agentmemory-port" . }}
ExecStop=$_mise --cd %h exec -- agentmemory stop

[Install]
WantedBy=default.target
UNIT
)
if [ -z "$_mise" ]; then
  fail "[agentmemory] mise not found"
elif ! systemctl --user show-environment >/dev/null 2>&1; then
  # No user systemd (container, WSL without systemd): nothing can register it.
  echo "[agentmemory] no systemd user session; start the server by hand: agentmemory" >&2
elif [ "$(cat "$_unit" 2>/dev/null)" != "$_want" ]; then
  { mkdir -p "${_unit%/*}" && printf '%s\n' "$_want" > "$_unit" && \
    systemctl --user daemon-reload && systemctl --user enable agentmemory.service && \
    systemctl --user restart agentmemory.service; } || fail "[agentmemory] systemd unit failed"
fi
{{- end }}
unset _mise _unit _want
{{ end -}}

{{ if .tools -}}
# codegraph MCP server, user scope. alwaysLoad keeps codegraph_explore out of tool-search deferral.
if command -v claude >/dev/null 2>&1; then
  claude mcp get codegraph >/dev/null 2>&1 || \
    claude mcp add-json --scope user codegraph \
      '{"type":"stdio","command":"codegraph","args":["serve","--mcp"],"alwaysLoad":true}' || \
    fail "[codegraph] mcp add failed"
fi
{{ end -}}

{{ if .tools -}}
# herdr's claude integration (every box with herdr): it reports each pane's session id, so a
# plain `herdr` after a reboot restores the layout AND resumes every Claude pane. Without it they
# come back as shells. The sshd profile below only adds starting herdr at boot.
mise --cd "$HOME" exec -- herdr integration status 2>/dev/null | grep -q '^claude: current' || \
  mise --cd "$HOME" exec -- herdr integration install claude || fail "[herdr] claude integration failed"
{{ end -}}

{{ if and .sshd .tools (eq .chezmoi.os "linux") -}}
# sshd profile (Linux, opt-in per machine): Claude stays reachable across SSH drops AND reboots.
# - herdr.service: `herdr server` holds the panes; after a restart it resumes each Claude pane
#   (`claude --resume <id>`), and a conversation that had Remote Control on re-attaches it.
# - claude-rc.service: `claude remote-control` server mode, so a NEW session can start from
#   claude.ai / the app. It exits after ~10 min offline, hence Restart=always.
# Linger starts the user manager at boot, with no login. Both need a full `claude auth login`
# and one interactive `claude remote-control` run first (enable + trust + spawn-mode prompts).
_mise=$(command -v mise || true); _claude=$(command -v claude || true)
_dir="$HOME/.config/systemd/user"
if [ -z "$_mise" ] || [ -z "$_claude" ]; then
  fail "[sshd] mise or claude not found"
elif ! systemctl --user show-environment >/dev/null 2>&1; then
  echo "[sshd] no systemd user session; run \`herdr server\` and \`claude remote-control\` by hand" >&2
else
  _herdr=$(cat <<UNIT
[Unit]
Description=herdr server (persistent agent panes)

[Service]
WorkingDirectory=%h
ExecStart=$_mise --cd %h exec -- herdr server
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
UNIT
)
  _rc=$(cat <<UNIT
[Unit]
Description=claude remote-control server
After=network-online.target

[Service]
WorkingDirectory={{ .claudeRcDir | default "%h" }}
ExecStart=$_claude remote-control --spawn same-dir --no-create-session-in-dir
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
UNIT
)
  _changed=0
  for _u in herdr claude-rc; do
    if [ "$_u" = herdr ]; then _want=$_herdr; else _want=$_rc; fi
    if [ "$(cat "$_dir/$_u.service" 2>/dev/null)" != "$_want" ]; then
      { mkdir -p "$_dir" && printf '%s\n' "$_want" > "$_dir/$_u.service"; } || fail "[sshd] writing $_u.service failed"
      _changed=1
    fi
  done
  if [ "$_changed" = 1 ]; then
    systemctl --user daemon-reload && systemctl --user enable --now herdr.service claude-rc.service || \
      fail "[sshd] enabling the units failed"
  fi
  [ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" = yes ] || \
    loginctl enable-linger "$USER" 2>/dev/null || sudo loginctl enable-linger "$USER" || \
    fail "[sshd] enable-linger failed (needed to start at boot without a login)"
fi
unset _mise _claude _dir _herdr _rc _changed _u _want
{{ end -}}

[ "$failed" = 0 ] || { echo "[bootstrap] part 2 had failures; fix them, then re-run chezmoi apply" >&2; exit 1; }
