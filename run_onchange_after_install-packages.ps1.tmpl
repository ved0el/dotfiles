# Windows bootstrap: scoop (OS package manager) + mise (runtimes/CLI tools). The
# analogue of run_onchange_after_install-packages.sh.tmpl for Unix. chezmoi runs this
# via the [interpreters.ps1] command set in .chezmoi.toml.tmpl. Re-runs automatically
# whenever this file's rendered content changes. tmux / sheldon / TPM are Unix-only
# and intentionally skipped here.
$ErrorActionPreference = 'Stop'

# --- env every later step + the PowerShell profile rely on (persisted for the user) ---
$LocalBin = Join-Path $HOME '.local\bin'
New-Item -ItemType Directory -Force -Path $LocalBin | Out-Null
$XdgConfig = Join-Path $HOME '.config'

function Add-UserPath([string]$Dir) {
  $current = [Environment]::GetEnvironmentVariable('Path', 'User')
  if ($current -notlike "*$Dir*") {
    [Environment]::SetEnvironmentVariable('Path', "$Dir;$current", 'User')
  }
  if ($env:Path -notlike "*$Dir*") { $env:Path = "$Dir;$env:Path" }
}

# ~/.local/bin holds chezmoi (the one-liner installs it there) + other self-installed
# tools. It is NOT on PATH by default on Windows, so persist it.
Add-UserPath $LocalBin

# XDG_CONFIG_HOME so mise (and other XDG-aware tools) read ~/.config/mise/conf.d —
# the SAME manifests used on macOS/Linux. Without this mise looks in %APPDATA%.
[Environment]::SetEnvironmentVariable('XDG_CONFIG_HOME', $XdgConfig, 'User')
$env:XDG_CONFIG_HOME = $XdgConfig

# NOTE: deliberately DO NOT set MISE_GLOBAL_CONFIG_FILE / MISE_CONFIG_DIR. They are redundant
# (mise already defaults to ~/.config/mise) AND they stop mise auto-discovering the conf.d/*.toml
# manifests when CWD is outside $HOME. The shell profiles unset them; see CLAUDE.md.

# Window-manager config homes — point komorebi/whkd/yasb at ~/.config/<tool>. These
# MUST be persisted (User scope): the WM apps launch at startup, outside any shell
# profile. komorebi defaults to ~/komorebi.json and whkd to ~/.config/whkdrc, so without
# these the chezmoi-managed configs under ~/.config/<tool> are not read.
foreach ($wm in 'komorebi','whkd','yasb') {
  $home_ = Join-Path $XdgConfig $wm
  $var = $wm.ToUpper() + '_CONFIG_HOME'
  [Environment]::SetEnvironmentVariable($var, $home_, 'User')
  Set-Item "env:$var" $home_
}

# --- scoop (package manager) — installs per-user; must NOT run elevated ---
if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
  Invoke-RestMethod -Uri 'https://get.scoop.sh' | Invoke-Expression
  $env:Path = "$env:USERPROFILE\scoop\shims;$env:Path"
}

# git via scoop (per-user, no elevation); curl ships with Windows 10+.
if (-not (Get-Command git -ErrorAction SilentlyContinue)) { scoop install git }

# pwsh 7 — the shell the managed profile targets (this bootstrap itself runs under WinPS 5.1).
# From WINGET, not scoop: the `winget` source ships Microsoft.PowerShell as an MSIX bundle, so it
# installs per-user with NO elevation and drops a `pwsh.exe` app alias into
# %LOCALAPPDATA%\Microsoft\WindowsApps, which is on the user PATH by default. PATH resolution is
# what matters: [cd] (`chezmoi cd`/`czcd`) and Claude Code's statusLine both invoke bare `pwsh`.
# Nothing bakes an absolute path — see CLAUDE.md "never bake pwsh's path".
if (-not (Get-Command pwsh -ErrorAction SilentlyContinue)) {
  if (Get-Command winget -ErrorAction SilentlyContinue) {
    $wgArgs = @('install', '--id', 'Microsoft.PowerShell', '--exact', '--source', 'winget',
                '--silent', '--accept-package-agreements', '--accept-source-agreements',
                '--disable-interactivity')
    winget @wgArgs
    if ($LASTEXITCODE -ne 0) {
      Write-Host "[win] winget pwsh install exited $LASTEXITCODE - install PowerShell 7 by hand."
    }
  } else {
    Write-Host "[win] winget not found - install PowerShell 7 by hand (czcd + Claude statusline need it)."
  }
}

# --- mise (runtimes + CLI tools, cross-platform — drives the tools/develop profiles) ---
if (-not (Get-Command mise -ErrorAction SilentlyContinue)) {
  scoop install mise
}

# Windows-only scoop extras. openssh/openssl provide commands, so guard on the command (an ssh
# from Git-for-Windows or the Windows optional feature already satisfies it). A font ships NO
# command, so that one is guarded on `scoop list`; JetBrainsMono-NF-Mono needs the nerd-fonts
# bucket, and the -Mono variant is the single-width one terminals want. Fonts install per-user
# (HKCU) — no elevation.
if (-not (Get-Command ssh     -ErrorAction SilentlyContinue)) { scoop install openssh }
if (-not (Get-Command openssl -ErrorAction SilentlyContinue)) { scoop install openssl }
if (-not (scoop list 2>$null | Select-String -Quiet '(?im)^\s*JetBrainsMono-NF-Mono\b')) {
  if ((scoop bucket list 2>$null | Out-String) -notmatch 'nerd-fonts') { scoop bucket add nerd-fonts }
  scoop install JetBrainsMono-NF-Mono
}

# --- install tools/runtimes declared in ~/.config/mise/conf.d/*.toml ---
# --cd $HOME: mise only auto-discovers the global conf.d/*.toml when CWD is inside the home
# tree; chezmoi may run this script from elsewhere, so anchor it at $HOME or nothing installs.
mise --cd $HOME install --yes

# rtk (rtk-ai/rtk) — install its Claude Code command-rewrite hook globally. --auto-patch
# edits ~/.claude/settings.json without prompting, keeping this bootstrap non-interactive;
# it's idempotent so re-runs are safe.
try { mise --cd $HOME exec -- rtk init -g --auto-patch } catch { }

# Claude Code itself — the marketplace step below is a no-op without it, and because the
# run_onchange fingerprint wouldn't change afterwards it would never retry on a fresh box.
# `irm https://claude.ai/install.ps1 | iex` is the official native install (the documented
# "Native Install (Recommended)" one-liner) — verbatim, so it stays greppable against the docs.
# It lands in ~/.local/bin (already on PATH from the top of this script) and AUTO-UPDATES from
# then on, which `winget install Anthropic.ClaudeCode` does not. Run inside `& { }` so the
# installer's own `Set-StrictMode` / `$ErrorActionPreference` stay in ITS scope, and try/catch
# so a network blip can't abort setup.
if (-not (Get-Command claude -ErrorAction SilentlyContinue)) {
  try { & { irm https://claude.ai/install.ps1 | iex } }
  catch { Write-Host "[claude] install failed: $($_.Exception.Message)" }
}

# Claude Code plugin marketplaces — clone newly-declared marketplaces and update the rest.
# Reads ~/.claude/settings.json (chezmoi-managed) for the declared set; plugins ship inside
# their marketplace repos, so this refreshes plugin code too. The fingerprint re-runs this
# script whenever the declared marketplaces change.
# settings fingerprint (incl. extraKnownMarketplaces): {{ include "dot_claude/settings.json.tmpl" | sha256sum }}
if (Get-Command claude -ErrorAction SilentlyContinue) { try { claude plugin marketplace update } catch { } }

{{ if .tools -}}
# delta: wire git via include.path (idempotent); identity stays in the unmanaged config.
if (Get-Command git -ErrorAction SilentlyContinue) {
  $deltaInc = Join-Path $HOME '.config/git/delta.gitconfig'
  if (((git config --global --get-all include.path) 2>$null) -notcontains $deltaInc) {
    git config --global --add include.path $deltaInc
  }
}
{{ end -}}

{{ if .wm -}}
# --- Windows tiling window manager (komorebi + whkd + yasb) — the `wm` profile,
#     analogue of the macOS yabai/skhd block. These live in scoop's extras bucket. ---
$buckets = scoop bucket list 2>$null | Out-String
if ($buckets -notmatch 'extras') { scoop bucket add extras }
# Install only what's missing so a re-run (cza) doesn't reinstall/upgrade each time.
$installed = scoop list 2>$null | Out-String
foreach ($app in 'komorebi','whkd','yasb') {
  if ($installed -notmatch "(?im)^\s*$app\b") { scoop install $app }
}
# Autostart komorebi at login via a scheduled task that runs the managed launcher
# (~/.config/komorebi/autostart.ps1). NOT `komorebic enable-autostart` / a shell:startup
# shortcut: at login the environment lacks scoop's shims on PATH, so `komorebic start` (which
# does `Start-Process komorebi.exe`) can't find komorebi.exe and komorebi never launches —
# nothing tiles (proven: strip <scoop>\shims from PATH and it reproduces). The launcher puts the
# shims dir — resolved HERE while PATH is intact and passed in — back on PATH, then starts
# komorebi+whkd with retry. It's run by System32 powershell.exe (WinPS 5.1 — always present; the
# winget/scoop pwsh isn't reliably on the task PATH) with -WindowStyle Hidden.
# Do NOT wrap this in `conhost.exe --headless`: that flag can't allocate its pseudoconsole during
# early session init, so the task dies at LOGON with 0x80070003 (ERROR_PATH_NOT_FOUND) and nothing
# tiles — while still succeeding when run on demand, which makes it look fine. It was added to
# suppress a console flash that actually came from `komorebic start` spawning pwsh; the launcher
# now starts komorebi.exe/whkd.exe directly, so there is no flash left to suppress.
if (Get-Command komorebic -ErrorAction SilentlyContinue) {
  # Drop any legacy shell:startup shortcut so it doesn't race the task.
  Remove-Item (Join-Path ([Environment]::GetFolderPath('Startup')) 'komorebi.lnk') -Force -ErrorAction SilentlyContinue
  try {
    $launcher = Join-Path $XdgConfig 'komorebi\autostart.ps1'
    $shims    = Split-Path (Get-Command komorebic).Source
    $winps    = Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
    $uid      = "$env:USERDOMAIN\$env:USERNAME"
    $act = New-ScheduledTaskAction -Execute $winps -Argument "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$launcher`" -ShimsDir `"$shims`""
    $trg = New-ScheduledTaskTrigger -AtLogOn -User $uid
    $set = New-ScheduledTaskSettingsSet -StartWhenAvailable -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -ExecutionTimeLimit ([TimeSpan]::Zero)
    $prn = New-ScheduledTaskPrincipal -UserId $uid -LogonType Interactive -RunLevel Limited
    Register-ScheduledTask -TaskName 'komorebi' -Action $act -Trigger $trg -Settings $set -Principal $prn -Force | Out-Null
    Write-Host "[wm] komorebi/whkd installed; autostart registered (scheduled task 'komorebi')."
  } catch {
    Write-Host "[wm] komorebi/whkd installed, but autostart task registration failed: $($_.Exception.Message)"
  }
}
Write-Host "[wm] Run yasb once (or add it to startup) to launch the status bar."
{{ end -}}

# --- wire the chezmoi-managed profile into the real $PROFILE for BOTH PowerShell 7
#     and Windows PowerShell 5.1. GetFolderPath('MyDocuments') is OneDrive-aware, so
#     this is correct even when Documents is redirected. Idempotent: only adds the
#     dot-source line once. ---
$Managed = Join-Path $XdgConfig 'powershell\profile.ps1'
$Docs = [Environment]::GetFolderPath('MyDocuments')
$ProfilePaths = @(
  (Join-Path $Docs 'PowerShell\Microsoft.PowerShell_profile.ps1'),        # PowerShell 7
  (Join-Path $Docs 'WindowsPowerShell\Microsoft.PowerShell_profile.ps1')  # Windows PowerShell 5.1
)
$ShimLine = ". '$Managed'"
foreach ($profilePath in $ProfilePaths) {
  New-Item -ItemType Directory -Force -Path (Split-Path $profilePath) | Out-Null
  if (-not (Test-Path $profilePath) -or
      -not (Select-String -Path $profilePath -SimpleMatch $Managed -Quiet)) {
    Add-Content -Path $profilePath -Value $ShimLine
  }
}
