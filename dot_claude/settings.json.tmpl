{
  "env": {
    "PONYTAIL_DEFAULT_MODE": "ultra"
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(npx:*)",
      "Bash(pnpx:*)",
      "Bash(pnpm:*)",
      "Bash(nvm use:*)",
      "Bash(printf:*)",
      "Bash(head:*)",
      "Bash(git:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(fd:*)",
      "Bash(rg:*)",
      "mcp__codegraph__codegraph_explore",
      "mcp__codegraph__codegraph_search",
      "mcp__codegraph__codegraph_node",
      "mcp__codegraph__codegraph_callers",
      "mcp__codegraph__codegraph_callees",
      "mcp__codegraph__codegraph_impact",
      "mcp__codegraph__codegraph_files",
      "mcp__codegraph__codegraph_status"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "{{ if eq .chezmoi.os "windows" }}pwsh -NoLogo -NoProfile -File {{ .chezmoi.homeDir }}/.claude/statusline.ps1{{ else }}bash $HOME/.claude/statusline.sh{{ end }}"
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": true,
    "ponytail@ponytail": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "last30days@last30days-skill": true,
    "playwright@claude-plugins-official": true,
    "cloudflare@cloudflare": false,
    "ecc@ecc": false
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      },
      "autoUpdate": true
    },
    "last30days-skill": {
      "source": {
        "source": "github",
        "repo": "mvanhorn/last30days-skill"
      },
      "autoUpdate": true
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "ecc": {
      "source": {
        "source": "github",
        "repo": "affaan-m/ECC"
      }
    }
  },
  "skillOverrides": {
    "brandkit": "off",
    "code-review": "off",
    "design-taste-frontend": "off",
    "design-taste-frontend-v1": "off",
    "diagnosing-bugs": "off",
    "domain-modeling": "off",
    "find-skills": "off",
    "full-output-enforcement": "off",
    "git-guardrails-claude-code": "off",
    "gpt-taste": "off",
    "high-end-visual-design": "off",
    "humanizer": "off",
    "image-to-code": "off",
    "imagegen-frontend-mobile": "off",
    "imagegen-frontend-web": "off",
    "industrial-brutalist-ui": "off",
    "migrate-to-shoehorn": "off",
    "minimalist-ui": "off",
    "prototype": "off",
    "redesign-existing-projects": "off",
    "research": "off",
    "scaffold-exercises": "off",
    "setup-pre-commit": "off",
    "stitch-design-taste": "off",
    "tdd": "off",
    "wizard": "off",
    "writing-for-agents": "off"
  },
  "model": "default",
  "advisorModel": "fable",
  "awaySummaryEnabled": false,
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "tui": "fullscreen",
  "timeFormat": "24-hour",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "autoScrollEnabled": true,
  "terminalProgressBarEnabled": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "defaultMode": "auto",
  "hasCompletedOnboarding": true
}
