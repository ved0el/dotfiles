# Windows bootstrap, part 2 of 2: Claude Code, its marketplaces/plugins/skills, rtk's hook and
# the codegraph MCP server. Runs after part 1 (alphabetical), so scoop/mise/tools exist. Its own
# fingerprint: declaring a plugin or skill re-runs only this, not scoop/mise.
$ErrorActionPreference = 'Stop'

# This script runs under WinPS 5.1 ([interpreters.ps1]) but INHERITS PSModulePath from whoever
# launched chezmoi. From pwsh 7 that list starts with pwsh's own module dirs, and 5.1 then
# autoloads pwsh 7's Microsoft.PowerShell.Security and dies ("Get-ExecutionPolicy ... module
# could not be loaded") at the first cmdlet from it - the scoop installer. It only bites when
# pwsh's $PSHOME is readable: an MSI install (Program Files\PowerShell\7, e.g. GitHub's
# runners) does, the Store/winget one (WindowsApps) is ACL-hidden from 5.1 and silently
# skipped. Reset to 5.1's own list before any module loads.
$env:PSModulePath = @(
  (Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'WindowsPowerShell\Modules')
  [Environment]::GetEnvironmentVariable('PSModulePath', 'Machine')
) -join ';'

# Separate process from part 1, whose $env:Path edits are gone: on a fresh box the persisted
# User PATH isn't in chezmoi's environment yet, so put ~/.local/bin (claude) and scoop's shims
# (mise) back for this run, plus XDG_CONFIG_HOME so `mise exec` finds ~/.config/mise/conf.d.
$env:XDG_CONFIG_HOME = Join-Path $HOME '.config'
foreach ($dir in (Join-Path $HOME '.local\bin'), (Join-Path $env:USERPROFILE 'scoop\shims')) {
  if ($env:Path -notlike "*$dir*") { $env:Path = "$dir;$env:Path" }
}

# rtk (rtk-ai/rtk) — install its Claude Code command-rewrite hook globally. --auto-patch
# edits ~/.claude/settings.json without prompting, keeping this bootstrap non-interactive;
# it's idempotent so re-runs are safe.
try { mise --cd $HOME exec -- rtk init -g --auto-patch } catch { }

# Claude Code itself — the marketplace step below is a no-op without it, and because the
# run_onchange fingerprint wouldn't change afterwards it would never retry on a fresh box.
# `irm https://claude.ai/install.ps1 | iex` is the official native install (the documented
# "Native Install (Recommended)" one-liner) — verbatim, so it stays greppable against the docs.
# It lands in ~/.local/bin (already on PATH from the top of this script) and AUTO-UPDATES from
# then on, which `winget install Anthropic.ClaudeCode` does not. Run inside `& { }` so the
# installer's own `Set-StrictMode` / `$ErrorActionPreference` stay in ITS scope, and try/catch
# so a network blip can't abort setup.
if (-not (Get-Command claude -ErrorAction SilentlyContinue)) {
  try { & { irm https://claude.ai/install.ps1 | iex } }
  catch { Write-Host "[claude] install failed: $($_.Exception.Message)" }
}

# Claude Code marketplaces + plugins — INSTALL ONLY WHAT'S MISSING. The ids below are
# rendered straight out of .chezmoitemplates/claude-settings.json, so that file stays the single
# source of truth and the rendered list doubles as this script's run_onchange fingerprint:
# declaring a new marketplace/plugin re-fires the script, unrelated settings churn doesn't.
# `plugin list`/`marketplace list` are local reads, so a box that already has everything
# does no network work. Refreshing what IS installed is `chezmoi update`'s job — see
# run_after_update-claude-plugins.ps1.
{{- $settings := includeTemplate "claude-settings.json" . | fromJson }}
if (Get-Command claude -ErrorAction SilentlyContinue) {
  $haveMk = @(); try { $haveMk = @((claude plugin marketplace list --json | Out-String | ConvertFrom-Json).name) } catch { }
{{- range $name, $mk := $settings.extraKnownMarketplaces }}
  if ($haveMk -notcontains '{{ $name }}') { try { claude plugin marketplace add '{{ index $mk.source "repo" | default (index $mk.source "url") }}' } catch { Write-Host "[claude] marketplace add {{ $name }} failed" } }
{{- end }}
  # -y is mandatory: the install prompt has no TTY here and would otherwise hang.
  $havePlugin = @(); try { $havePlugin = @((claude plugin list --json | Out-String | ConvertFrom-Json).id) } catch { }
{{- range $id, $_ := $settings.enabledPlugins }}
  if ($havePlugin -notcontains '{{ $id }}') { try { claude plugin install -y '{{ $id }}' } catch { Write-Host "[claude] install {{ $id }} failed" } }
{{- end }}
}

# Agent skills from repos with no plugin marketplace — `skills` CLI, the official method in their
# READMEs. Declared as `repo:skillspec:anchor`:
#   skillspec - the `--skill` value. A name (repo basename is NOT always it: vercel-labs/skills
#               ships `find-skills`), or `*` for "every skill this repo ships", which keeps up
#               with upstream on its own (mattpocock/skills went 38 -> 37 names in three days,
#               taste-skill 10 -> 13; a pinned name list would rot and fail on removed names).
#   anchor    - the skill dir whose presence means "this repo is already done here". Exact for a
#               single-skill entry; a representative one for a `*` entry, since knowing the full
#               set of a `*` repo needs the network we are trying to avoid. Delete
#               ~/.claude/skills/<anchor> to force a reinstall.
# INSTALL ONLY WHAT'S MISSING - the CLI lands skills in the UNMANAGED ~/.claude/skills/<name>, so
# `apply` never fights them and that dir is the check. Refreshing is `chezmoi update`'s job, see
# run_after_update-claude-plugins.ps1. Flags are load-bearing for a non-interactive run: `npx -y`
# skips npx's own prompt, the trailing `-y` the CLI's confirmation, `--agent claude-code` the
# agent picker (WITHOUT it the skill installs for codex/gemini/copilot only and Claude never sees
# it), `--skill` pins the selection, `--copy` avoids symlinks (they need elevation on Windows,
# which this bootstrap never takes). npx comes from mise's node ("develop" profile) - hence
# `mise exec`, same as rtk above; a tools-only box goes without.
foreach ($entry in 'tt-a1i/archify:archify:archify', 'mattpocock/skills:*:ask-matt') {
  $repo, $spec, $anchor = $entry.Split(':')
  if (Test-Path (Join-Path $HOME ".claude\skills\$anchor")) { continue }
  # Empty catch = mise itself missing (CommandNotFound IS terminating, like the rtk line);
  # $LASTEXITCODE = npx/node missing, which a native non-zero exit does NOT throw under WinPS 5.1.
  try { mise --cd $HOME exec -- npx -y skills add $repo --skill $spec --agent claude-code -g -y --copy } catch { }
  if ($LASTEXITCODE -ne 0) { Write-Host "[skills] $repo skipped - needs node/npx (the develop profile)" }
}

# Retired skill repos (humanizer, find-skills, Leonxlnx/taste-skill) - see the .sh twin.
# ponytail: one-shot cleanup; delete this block once every box has applied it.
if ((Test-Path (Join-Path $HOME '.claude\skills\brandkit')) -or (Test-Path (Join-Path $HOME '.claude\skills\humanizer'))) {
  $retired = @('humanizer', 'find-skills', 'brandkit', 'design-taste-frontend', 'design-taste-frontend-v1',
               'full-output-enforcement', 'gpt-taste', 'high-end-visual-design', 'image-to-code',
               'imagegen-frontend-mobile', 'imagegen-frontend-web', 'industrial-brutalist-ui',
               'minimalist-ui', 'redesign-existing-projects', 'stitch-design-taste')
  try { mise --cd $HOME exec -- npx -y skills remove -g -y @retired } catch { Write-Host "[skills] retired-skill cleanup failed" }
}

{{ if .tools -}}
# codegraph MCP server, user scope. `cmd /c` because the launcher is codegraph.cmd, which a
# shell-less spawn can't run. alwaysLoad keeps codegraph_explore out of tool-search deferral.
# WinPS 5.1 strips bare `"` from native args, hence the \" escaping.
# The probe runs under 'Continue': with 'Stop', 5.1 turns a native command's redirected stderr
# ("No MCP server named …" on a fresh box) into a terminating error and kills the script.
$cgHave = $true
if (Get-Command claude -ErrorAction SilentlyContinue) {
  $cgHave = & { $ErrorActionPreference = 'Continue'; claude mcp get codegraph 2>&1 | Out-Null; $LASTEXITCODE -eq 0 }
}
if (-not $cgHave) {
  $cgJson = @{ type = 'stdio'; command = 'cmd'; args = @('/c', 'codegraph', 'serve', '--mcp'); alwaysLoad = $true } | ConvertTo-Json -Compress
  try { claude mcp add-json --scope user codegraph $cgJson.Replace('"', '\"') } catch { Write-Host "[codegraph] mcp add failed" }
}
{{ end -}}
