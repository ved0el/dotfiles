{{- /* chezmoi:modify-template */ -}}
{{- /* Merge the curated keys from .chezmoitemplates/claude-settings.json into the LIVE
     ~/.claude/settings.json instead of replacing it: Claude writes machine-local keys
     (plugin toggles, approved commands) here all the time. Object-valued keys merge one
     level deep with the curated entry winning (hooks per event, so tool-installed events
     like herdr's SessionStart survive); permissions.allow is a union; scalars are replaced.
     Keys only the live file has are kept. */ -}}
{{- $live := dict -}}
{{- if .chezmoi.stdin -}}{{- $live = fromJson .chezmoi.stdin -}}{{- end -}}
{{- $want := includeTemplate "claude-settings.json" . | fromJson -}}
{{- range $k, $v := $want -}}
{{-   $old := get $live $k -}}
{{-   if and (kindIs "map" $v) (kindIs "map" $old) -}}
{{- /* not sprig merge: mergo treats false/""/0 as empty and lets the live value win */ -}}
{{-     $m := deepCopy $old -}}
{{-     range $kk, $vv := $v -}}{{- $_ := set $m $kk $vv -}}{{- end -}}
{{-     if eq $k "permissions" -}}
{{-       $_ := set $m "allow" (concat (default list (get $v "allow")) (default list (get $old "allow")) | uniq) -}}
{{-     end -}}
{{-     $_ := set $live $k $m -}}
{{-   else -}}
{{-     $_ := set $live $k $v -}}
{{-   end -}}
{{- end -}}
{{- /* Retired keys: live-only keys survive the merge above, so a key dropped from the template
     must be unset here. claude-mem -> agentmemory.
     ponytail: one-shot; delete once every box has applied it. */ -}}
{{- $retired := dict
      "env" (list "CLAUDE_MEM_CONTEXT_SHOW_TERMINAL_OUTPUT" "CLAUDE_MEM_WELCOME_HINT_ENABLED" "CLAUDE_MEM_TELEMETRY" "CLAUDE_MEM_TELEMETRY_ERRORS")
      "enabledPlugins" (list "claude-mem@thedotmack")
      "extraKnownMarketplaces" (list "thedotmack") -}}
{{- range $k, $keys := $retired -}}
{{-   $m := get $live $k -}}
{{-   if kindIs "map" $m -}}{{- range $keys -}}{{- $_ := unset $m . -}}{{- end -}}{{- end -}}
{{- end -}}
{{ toPrettyJson $live }}
