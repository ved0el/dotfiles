#!/bin/sh
# Bootstrap, part 2 of 2: Claude Code, its marketplaces/plugins/skills, rtk's hook and the
# codegraph MCP server. Runs after part 1 (alphabetical), so mise + its tools exist. Its own
# fingerprint: declaring a plugin or skill re-runs only this, not the package install.
set -eu
# Separate process from part 1: ~/.local/bin (mise, claude) has to go on PATH again.
export PATH="$HOME/.local/bin:$PATH"

# rtk (rtk-ai/rtk) — install its Claude Code command-rewrite hook globally. --auto-patch
# edits ~/.claude/settings.json without prompting, keeping this bootstrap non-interactive;
# it's idempotent so re-runs are safe, and `|| true` keeps a hiccup from aborting setup.
command -v rtk >/dev/null 2>&1 && rtk init -g --auto-patch || \
  mise --cd "$HOME" exec -- rtk init -g --auto-patch || true

# Claude Code itself — the marketplace step below is a no-op without it, and since the
# run_onchange fingerprint wouldn't change afterwards it would never retry on a fresh box.
# Official installer; lands in ~/.local/bin (already on PATH above) and self-updates after that.
command -v claude >/dev/null 2>&1 || \
  curl -fsSL https://claude.ai/install.sh | bash || \
  echo "[claude] install failed — install Claude Code by hand"

# Claude Code marketplaces + plugins — INSTALL ONLY WHAT'S MISSING. The ids below are
# rendered straight out of .chezmoitemplates/claude-settings.json, so that file stays the single
# source of truth and the rendered list doubles as this script's run_onchange fingerprint:
# declaring a new marketplace/plugin re-fires the script, unrelated settings churn doesn't.
# `plugin list`/`marketplace list` are local reads, so a box that already has everything
# does no network work. Refreshing what IS installed is `chezmoi update`'s job — see
# run_after_update-claude-plugins.sh. grep -F over the --json dump keeps this jq-free.
{{- $settings := includeTemplate "claude-settings.json" . | fromJson }}
if command -v claude >/dev/null 2>&1; then
  have_mk=$(claude plugin marketplace list --json 2>/dev/null || true)
{{- range $name, $mk := $settings.extraKnownMarketplaces }}
  printf '%s' "$have_mk" | grep -qF '"name": "{{ $name }}"' || \
    claude plugin marketplace add '{{ index $mk.source "repo" | default (index $mk.source "url") }}' || \
    echo "[claude] marketplace add {{ $name }} failed"
{{- end }}
  # -y is mandatory: the install prompt has no TTY here and would otherwise hang.
  have_plugin=$(claude plugin list --json 2>/dev/null || true)
{{- range $id, $_ := $settings.enabledPlugins }}
  printf '%s' "$have_plugin" | grep -qF '"{{ $id }}"' || \
    claude plugin install -y '{{ $id }}' || echo "[claude] install {{ $id }} failed"
{{- end }}
fi

# Agent skills from repos with no plugin marketplace — `skills` CLI, the official method in their
# READMEs. Declared as `repo:skillspec:anchor`:
#   skillspec — the `--skill` value. A name (repo basename is NOT always it: vercel-labs/skills
#               ships `find-skills`), or `*` for "every skill this repo ships", which keeps up
#               with upstream on its own (mattpocock/skills went 38 -> 37 names in three days,
#               taste-skill 10 -> 13; a pinned name list would rot and fail on removed names).
#   anchor    — the skill dir whose presence means "this repo is already done here". Exact for a
#               single-skill entry; a representative one for a `*` entry, since knowing the full
#               set of a `*` repo needs the network we are trying to avoid. Delete
#               ~/.claude/skills/<anchor> to force a reinstall.
# INSTALL ONLY WHAT'S MISSING — the CLI lands skills in ~/.claude/skills/<name>, which chezmoi
# does NOT manage, so `apply` never fights them and that dir is the check. Refreshing is
# `chezmoi update`'s job, see run_after_update-claude-plugins.sh. Every flag is load-bearing for
# a non-interactive run: `npx -y` skips npx's own "install skills?" prompt on a cold cache, the
# trailing `-y` skips the CLI's confirmation, `--agent claude-code` stops it asking which agent
# (WITHOUT it the skill installs for codex/gemini/copilot only and Claude never sees it),
# `--skill` pins the selection, and `--copy` avoids symlinks (Windows symlinks need elevation,
# which this bootstrap never takes). npx comes from mise's node ("develop" profile), so try PATH,
# then mise, then warn — a tools-only box simply goes without.
for _entry in tt-a1i/archify:archify:archify 'mattpocock/skills:*:ask-matt'; do
  _repo="${_entry%%:*}"; _rest="${_entry#*:}"; _spec="${_rest%:*}"; _anchor="${_rest##*:}"
  if [ -e "$HOME/.claude/skills/$_anchor" ]; then continue; fi
  command -v npx >/dev/null 2>&1 && \
    npx -y skills add "$_repo" --skill "$_spec" --agent claude-code -g -y --copy || \
    mise --cd "$HOME" exec -- npx -y skills add "$_repo" --skill "$_spec" --agent claude-code -g -y --copy || \
    echo "[skills] $_repo skipped — needs node/npx (the develop profile)"
done
unset _entry _repo _rest _spec _anchor

# Retired skill repos (humanizer, find-skills, Leonxlnx/taste-skill): every skill they shipped
# was switched off in skillOverrides, so they're gone. `skills remove` (not rm -rf) also drops
# them from the CLI's lock, or czu's `skills update` would bring them back. Anchor-guarded.
# ponytail: one-shot cleanup; delete this block once every box has applied it.
if [ -e "$HOME/.claude/skills/brandkit" ] || [ -e "$HOME/.claude/skills/humanizer" ]; then
  mise --cd "$HOME" exec -- npx -y skills remove -g -y humanizer find-skills brandkit \
    design-taste-frontend design-taste-frontend-v1 full-output-enforcement gpt-taste \
    high-end-visual-design image-to-code imagegen-frontend-mobile imagegen-frontend-web \
    industrial-brutalist-ui minimalist-ui redesign-existing-projects stitch-design-taste \
    || echo "[skills] retired-skill cleanup failed"
fi

{{ if .tools -}}
# codegraph MCP server, user scope. alwaysLoad keeps codegraph_explore out of tool-search deferral.
if command -v claude >/dev/null 2>&1; then
  claude mcp get codegraph >/dev/null 2>&1 || \
    claude mcp add-json --scope user codegraph \
      '{"type":"stdio","command":"codegraph","args":["serve","--mcp"],"alwaysLoad":true}' || \
    echo "[codegraph] mcp add failed"
fi
{{ end -}}
